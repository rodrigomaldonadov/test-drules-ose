            moneda != null,
            moneda.trim().length() > 0,
            moneda not matches "PEN|USD|EUR|GBP|JPY|CAD|CHF|AUD|BRL|MXN|CLP|COP|ARS|BOB|PYG|UYU|VES"
        )
        $res : ResultadoValidacion()
