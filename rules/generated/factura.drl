// Código 1001
rule "R1001"
    when
        $ctx : CpeContext( formatoSerieCorrelativoInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1001", "ID - El dato SERIE-CORRELATIVO no cumple con el formato de acuerdo al tipo de comprobante");
end


// Código 1002
rule "R1002"
    when
        $ctx : CpeContext(
            customizationID != null,
            customizationID.trim().length() > 0,
            customizationID != "2.0"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1002", "CustomizationID - El valor del tag es diferente a 2.0");
end


// Código 1003
rule "R1003"
    when
        $ctx : CpeContext(
            tipoDocumento != null,
            tipoDocumento.trim().length() > 0,
            tipoArchivoDistintoXml == true
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1003", "InvoiceTypeCode - El valor del tipo de documento es invalido o no coincide con el nombre del archivo");
end


// Código 1004
rule "R1004"
    when
        $ctx : CpeContext( tipoDocumento == null || tipoDocumento.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("1004", "El XML no contiene el tag o no existe informacion de InvoiceTypeCode");
end


// Código 1007
rule "R1007"
    when
        $ctx : CpeContext(
            schemeIdEmisor != null,
            schemeIdEmisor.trim().length() > 0,
            schemeIdEmisor != "6"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1007", "El dato ingresado no cumple con el estandar");
end


// Código 1008
rule "R1008"
    when
        $ctx : CpeContext(
            schemeIdEmisor == null || schemeIdEmisor.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1008", "El XML no contiene el tag o no existe informacion en tipo de documento del emisor.");
end


// Código 1010
rule "R1010"
    when
        $ctx : CpeContext( faltaIssueDateGlobal == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1010", "El XML no contiene el tag IssueDate");
end


// Código 1011
rule "R1011"
    when
        $ctx : CpeContext( faltaIssueDateGlobal == false, issueDateValorInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1011", "IssueDate- El dato ingresado no es valido");
end


// Código 1012
rule "R1012"
    when
        $ctx : CpeContext( formatoSerieCorrelativoInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1012", "ID - El dato ingresado no cumple con el patron SERIE-CORRELATIVO");
end


// Código 1017
rule "R1017"
    when
        $ctx : CpeContext( serie == null || serie.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("1017", "El XML no contiene el tag ID o la serie esta vacia");
end


// Código 1018
rule "R1018"
    when
        $ctx : CpeContext(
            esBoleta == true,
            serie != null,
            serie.trim().length() > 0,
            serie not matches "^[Bb]\\d{3}$"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1018", "La serie del comprobante no cumple con el formato para Boleta (Bxxx)");
end


// Código 1019
rule "R1019"
    when
        $ctx : CpeContext(
            numero != null,
            numero.trim().length() > 0,
            numero not matches "^[0-9]\\d{0,7}$"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1019", "El numero de comprobante no cumple con el formato (1 a 99999999)");
end


// Código 1032
rule "R1032"
    when
        $ctx : CpeContext( duplicado == true, esFactura == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1032", "El comprobante ya esta informado y se encuentra con estado anulado o rechazado");
end


// Código 1033
rule "R1033"
    when
        $ctx : CpeContext( duplicado == true, esFactura == false )
        $res : ResultadoValidacion()
    then
        $res.addError("1033", "El comprobante fue registrado previamente con otros datos");
end


// Código 1034
rule "R1034"
    when
        $ctx : CpeContext( rucArchivoDistintoXml == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1034", "Numero de RUC del nombre del archivo no coincide con el consignado en el contenido del archivo XML");
end


// Código 1035
rule "R1035"
    when
        $ctx : CpeContext( serieArchivoDistintaXml == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1035", "Numero de Serie del nombre del archivo no coincide con el consignado en el contenido del archivo XML");
end


// Código 1036
rule "R1036"
    when
        $ctx : CpeContext( numeroArchivoDistintoXml == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1036", "Numero de documento en el nombre del archivo no coincide con el consignado en el contenido del XML");
end


// Código 1037
rule "R1037"
    when
        $ctx : CpeContext(
            razonSocialEmisor == null || razonSocialEmisor.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1037", "El XML no contiene el tag o no existe informacion de RegistrationName del emisor del documento");
end


// Código 1078
rule "R1078"
    when
        $ctx : CpeContext( emisorObligadoSeeSol == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1078", "El emisor no se encuentra autorizado a emitir en el SEE-Desde los sistemas del contribuyente");
end


// Código 1080
rule "R1080"
    when
        $ctx : CpeContext( tipoOperacion != null,
                           tipoOperacion in ("2100","2101","2102","2103","2104","0112"),
                           emisorAfiliadoEmpresasSupervisadas == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1080", "Debe enviar su comprobante por el SEE-Empresas supervisadas");
end


// Código 1083
rule "R1083"
    when
        $ctx : CpeContext( tipoDocumentoReceptor == "6",
                           rucReceptorNoExiste == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1083", "El numero de RUC del receptor no existe");
end


// Código 1086
rule "R1086"
    when
        $ctx : CpeContext( emisorEsSsco == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1086", "El emisor electronico es un Sujeto sin capacidad operativa (SSCO)");
end


// Código 2010
rule "2010 - CPE contribuyente no esta activo"
salience 1000
when
    $ctx : CpeContext(contribuyenteNoActivo == true ) 
    $r : ResultadoValidacion()
then
    $r.addError("2010", "El contribuyente no esta activo");
end


// Código 2011
rule "R2011"
    when
        $ctx : CpeContext(false)
        $res : ResultadoValidacion()
    then
        $res.addError("2011", "El contribuyente no esta habido");
end


// Código 2014
rule "R2014"
    when
        $ctx : CpeContext( docCliente == null || docCliente.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2014", "El XML no contiene el tag o no existe informacion del numero de documento de identidad del receptor del documento");
end


// Código 2015
rule "R2015"
    when
        $ctx : CpeContext( tipoDocCliente == null || tipoDocCliente.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2015", "El XML no contiene el tag o no existe informacion del tipo de documento de identidad del receptor del documento");
end


// Código 2017
rule "R2017"
    when
        $ctx : CpeContext(
            tipoDocCliente == "6",
            docCliente != null,
            docCliente not matches "\\d{11}"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2017", "El numero de documento de identidad del receptor debe ser RUC");
end


// Código 2021
rule "R2021"
    when
        $ctx : CpeContext(
            nombreCliente == null || nombreCliente.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2021", "El XML no contiene el tag o no existe informacion de RegistrationName del receptor del documento");
end


// Código 2022
rule "R2022"
    when
        $ctx : CpeContext(
            nombreCliente != null,
            ( nombreCliente.trim().length() < 3 || nombreCliente.trim().length() > 1500 )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2022", "RegistrationName - El dato ingresado no cumple con el estandar");
end


// Código 2023
rule "R2023"
    when
        $linea : LineaContext( numeroItem == null || numeroItem <= 0 || numeroItem != posicionLinea )
        $res : ResultadoValidacion()
    then
        $res.addError("2023", "El Numero de orden del item no cumple con el formato establecido");
end


// Código 2024
rule "R2024"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext(
            cantidad == null || cantidad.compareTo( java.math.BigDecimal.ZERO ) <= 0
        ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2024", "El XML no contiene el tag InvoicedQuantity en el detalle de los Items o es cero (0)");
end


// Código 2025
rule "R2025"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext(!DecimalUtils.formatoValido(cantidad, 12, 10)) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2025", "InvoicedQuantity El dato ingresado no cumple con el estandar");
end


// Código 2026
rule "R2026"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext(
            descripcion == null || descripcion.trim().length() == 0
        ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2026", "El XML no contiene el tag cac:Item/cbc:Description en el detalle de los Items");
end


// Código 2027
rule "R2027"
    when
        $ctx : CpeContext(lineas != null )
        $linea : LineaContext( descripcion == null, descripcion.trim().length() > 500 ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2027", "El XML no contiene el tag o no existe informacion de cac:Item/cbc:Description del item");
end


// Código 2028
rule "R2028"
    when
        $ctx : CpeContext( faltaAlternativeConditionPrice == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2028", "Debe existir el tag cac:AlternativeConditionPrice");
end


// Código 2029
rule "R2029"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext( precioUnitario == null ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2029", "El XML no contiene el precio de venta unitario (PriceAmount con priceTypeCode 01)");
end


// Código 2031
rule "R2031"
    when
        $ctx : CpeContext(!DecimalUtils.formatoValido(subtotal, 12, 2))
        $res : ResultadoValidacion()
    then
        $res.addError("2031", "El dato ingresado en total valor de venta no cumple con el estandar");
end


// Código 2033
rule "R2033"
    when
        $ctx : CpeContext( taxAmountLineaFormatoInvalido == true )   // <-- corregido
        $res : ResultadoValidacion()
    then
        $res.addError("2033", "El dato ingresado en TaxAmount de la linea no cumple con el formato establecido");
end


// Código 2036
rule "R2036"
    when
        $ctx : CpeContext( codigoTributoLineaInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2036", "El codigo del tributo es invalido");
end


// Código 2037
rule "R2037"
    when
        $ctx : CpeContext( faltaTaxSchemeIdLinea == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2037", "El XML no contiene el tag cac:TaxCategory/cac:TaxScheme/cbc:ID del Item");
end


// Código 2040
rule "R2040"
    when
        $ctx : CpeContext( tipoAfectacionIgvIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2040", "El tipo de afectacion del IGV es incorrecto");
end


// Código 2041
rule "R2041"
    when
        $ctx : CpeContext( sistemaCalculoIscIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2041", "El sistema de calculo del ISC es incorrecto");
end


// Código 2044
rule "R2044"
    when
        $ctx : CpeContext( total == null )
        $res : ResultadoValidacion()
    then
        $res.addError("2044", "PayableAmount es obligatorio");
end


// Código 2048
rule "R2048"
    when
        $ctx : CpeContext(!DecimalUtils.formatoValido(taxamuntGlobal, 12, 2) )
        $res : ResultadoValidacion()
    then
        $res.addError("2048", "El dato ingresado en TaxAmount no cumple con el formato establecido");
end


// Código 2052
rule "R2052"
    when
        $ctx : CpeContext( faltaCodigoTributoInternacionalGlobal == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2052", "El XML no contiene el tag codigo de tributo internacional de impuestos globales");
end


