// Código 2800
rule "R2800"
    when
        $ctx : CpeContext(
            tipoOperacion != null,
            tipoOperacion matches "0200|0201|0202|0203|0204|0205|0206|0207|0208|0401",
            tipoDocCliente != null,
            tipoDocCliente != "6"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2800", "El dato ingresado en el tipo de documento de identidad del receptor no esta permitido.");
end


// Código 2801
rule "R2801"
    when
        $ctx : CpeContext(
            tipoDocCliente == "1",
            docCliente != null,
            docCliente not matches "\\d{8}"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2801", "El DNI ingresado no cumple con el estandar.");
end


// Código 2802
rule "R2802"
    when
        $ctx : CpeContext( tipoDocumentoReceptor in ("4","7","0","A","B","C","D","E","G"),
                           numeroDocumentoReceptor != null,
                           numeroDocumentoReceptor not matches "^[a-zA-Z0-9]{1,15}$" )
        $res : ResultadoValidacion()
    then
        $res.addError("2802", "El dato ingresado como numero de documento de identidad del receptor no cumple con el formato establecido");
end


