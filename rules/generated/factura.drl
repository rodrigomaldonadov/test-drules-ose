rule "R3275"
    when
        $ctx : CpeContext( sumaVentaExoneradasLineaIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3275", "La sumatoria del total valor de venta - operaciones exoneradas de linea no corresponden al total");
end


// Código 3276
rule "R3276"
    when
        $ctx : CpeContext( sumaVentaGratuitasLineaIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3276", "La sumatoria del total valor de venta - operaciones gratuitas de linea no corresponden al total");
end


// Código 3277
rule "R3277"
    when
        $ctx : CpeContext( sumaVentaGravadasLineaIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3277", "La sumatoria del total valor de venta - operaciones gravadas de linea no corresponden al total");
end


// Código 3278
rule "R3278"
    when
        $ctx : CpeContext( sumaValorVentaIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3278", "La sumatoria de valor de venta no corresponde a los importes consignados");
end


// Código 3279
rule "R3279"
    when
        $ctx : CpeContext( valorVentaImpuestosNoConcuerda == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3279", "La sumatoria del Total del valor de venta mas los impuestos no concuerda con la base imponible");
end


// Código 3280
rule "R3280"
    when
        $ctx : CpeContext(
            total != null,
            totalConsistente == false
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3280", "El importe total del comprobante no coincide con el valor calculado");
end


// Código 3281
rule "R3281"
    when
        $ctx : CpeContext( emisorNoInscritoRea == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3281", "El emisor electronico no se encuentra inscrito en el Registro de Establecimientos Autorizados (REA)");
end


// Código 3282
rule "R3282"
    when
        $ctx : CpeContext( descuentosAnticipoSinTotalAnticipos == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3282", "Si se informa descuentos globales por anticipo debe existir 'Total de anticipos' con monto mayor a cero");
end


// Código 3283
rule "R3283"
    when
        $ctx : CpeContext( tieneLeyenda2001 == true,
                           totalValorVentaExoneradas <= 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("3283", "Si se utiliza la leyenda con codigo 2001, el total de operaciones exoneradas debe ser mayor a 0.00");
end


// Código 3284
rule "R3284"
    when
        $ctx : CpeContext( tieneLeyenda2002 == true,
                           totalValorVentaExoneradas <= 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("3284", "Si se utiliza la leyenda con codigo 2002, el total de operaciones exoneradas debe ser mayor a 0.00");
end


// Código 3285
rule "R3285"
    when
        $ctx : CpeContext( tieneLeyenda2003 == true,
                           totalValorVentaExoneradas <= 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("3285", "Si se utiliza la leyenda con codigo 2003, el total de operaciones exoneradas debe ser mayor a 0.00");
end


// Código 3287
rule "R3287"
    when
        $ctx : CpeContext( totalAnticiposSinDescuentosGlobales == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3287", "Si se informa 'Total de anticipos' debe consignar los descuentos globales por anticipo con monto mayor a cero");
end


// Código 3288
rule "R3288"
    when
        $ctx : CpeContext( subtotal == null )
        $res : ResultadoValidacion()
    then
        $res.addError("3288", "Debe consignar el Total Valor de Venta");
end


// Código 3289
rule "R3289"
    when
        $ctx : CpeContext( tieneLeyenda2008 == true,
                           totalValorVentaExoneradas <= 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("3289", "Si se utiliza la leyenda con codigo 2008, el total de operaciones exoneradas debe ser mayor a 0.00");
end


// Código 3290
rule "R3290"
    when
        $ctx : CpeContext( cargoDescItemDifiere == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3290", "El valor de cargo/descuento por item difiere de los importes consignados.");
end


// Código 3291
rule "R3291"
    when
        $ctx : CpeContext(
            		
            totalIGV != null,
            igvConsistente == false
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3291", "El calculo del IGV es Incorrecto");
end


// Código 3292
rule "R3292"
    when
        $ctx : CpeContext( totalImpuestosLineaNoCoincide == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3292", "El importe total de impuestos por linea no coincide con la sumatoria de los impuestos por linea.");
end


// Código 3293
rule "R3293"
    when
        $ctx : CpeContext( sumaVentaIvapLineaIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3293", "La sumatoria del total valor de venta - IVAP de linea no corresponden al total");
end


// Código 3294
rule "R3294"
    when
        $ctx : CpeContext( sumaImpuestosGlobalesIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3294", "La sumatoria de impuestos globales no corresponde al monto total de impuestos.");
end


// Código 3295
rule "R3295"
    when
        $ctx : CpeContext( importeIvapNoCorresponde == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3295", "El importe del IVAP no corresponden al determinado por la informacion consignada.");
end


// Código 3296
rule "R3296"
    when
        $ctx : CpeContext(
            totalISC != null,
            totalISC.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3296", "La sumatoria del monto base - ISC de linea no corresponden al total");
end


// Código 3297
rule "R3297"
    when
        $ctx : CpeContext(
            totalOtrosTributos != null,
            totalOtrosTributos.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3297", "La sumatoria del monto base - Otros tributos de linea no corresponden al total");
end


// Código 3298
rule "sumatoria del total del importe del tributo ISC "
    when

        $ctx : CpeContext(
            totalISC != null,
            totalISC.compareTo( java.math.BigDecimal.ZERO ) > 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3298", "La sumatoria del total del importe del tributo ISC de linea no corresponden al total");
end


// Código 3299
rule "R3299"
    when
        $ctx : CpeContext( sumaOtrosTributosLineaIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3299", "La sumatoria del total del importe del tributo Otros tributos de linea no corresponden al total");
end


// Código 3300
rule "R3300"
    when
        $ctx : CpeContext( sumaDescuentosGlobalesIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3300", "La sumatoria consignada en descuentos globales no corresponden al total.");
end


// Código 3301
rule "R3301"
    when
        $ctx : CpeContext( sumaCargosGlobalesIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3301", "La sumatoria consignados en cargos globales no corresponden al total");
end


// Código 3302
rule "R3302"
    when
        $ctx : CpeContext( sumaIgvGratuitasLineaIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3302", "La sumatoria de los IGV de operaciones gratuitas de la linea (codigo tributo 9996) no corresponden al total");
end


// Código 3303
rule "R3303"
    when
        $ctx : CpeContext( redondeoImporteTotalExcede == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3303", "El monto para el redondeo del Importe Total excede el valor permitido");
end


// Código 3305
rule "R3305"
    when
        $ctx : CpeContext( faltaTotalPrecioVenta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3305", "Debe consignar el Total Precio de Venta");
end


// Código 3306
rule "R3306"
    when
        $ctx : CpeContext( sumaIcbperLineaIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3306", "La sumatoria del total del importe del tributo ICBPER de linea no corresponden al total");
end


// Código 3307
rule "R3307"
    when
        $ctx : CpeContext( cargoDescGlobalDifiere == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3307", "El valor de cargo/descuento global difiere de los importes consignados");
end


// Código 3308
rule "R3308"
    when
        $ctx : CpeContext( tienePercepcion == true,
                           tipoOperacion != "2001" )
        $res : ResultadoValidacion()
    then
        $res.addError("3308", "Solo debe consignar informacion de percepciones si el tipo de operacion es 2001-Operacion sujeta a Percepcion");
end


// Código 3309
rule "R3309"
    when
        $ctx : CpeContext( tipoOperacion == "2001",
                           formaPagoContado == true,
                           sinPaymentTermsPercepcion == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3309", "Si forma de pago es Contado debe consignar un Payment Terms con indicador Percepcion");
end


// Código 3310
rule "R3310"
    when
        $ctx : CpeContext( tipoOperacion == "2001",
                           faltaMontoTotalPercepcion == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3310", "Debe consignar el Monto total incluido la percepcion");
end


// Código 3311
rule "R3311"
    when
        $ctx : CpeContext( montoTotalPercepcionInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3311", "El Monto total incluido la percepcion no cumple con el formato establecido");
end


// Código 3316
rule "R3316"
    when
        $ctx : CpeContext( tipoOperacion == "2002",
                           faltaDatosRetencion2daCategoria == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3316", "Si el tipo de operacion es 2002, debe informar los datos de la retencion de segunda categoria");
end


// Código 3317
rule "R3317"
    when
        $ctx : CpeContext( tieneRetencion2daCategoria == true,
                           tipoOperacion != "2002" )
        $res : ResultadoValidacion()
    then
        $res.addError("3317", "Si consigna infomacion de la retencion de segunda categoria, el tipo de operacion debe ser 2002");
end


// Código 3318
rule "R3318"
    when
        $ctx : CpeContext( faltaBaseRetencion2da == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3318", "Debe consignar la base de la retencion de segunda categoria");
end


// Código 3319
rule "R3319"
    when
        $ctx : CpeContext( sumaCuotasDistintaMontoNeto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3319", "La suma de las cuotas debe ser igual al Monto neto pendiente de pago.");
end


// Código 3330
rule "R3330"
    when
        $ctx : CpeContext( tienePercepcion == true,
                           formaPagoContado == false )
        $res : ResultadoValidacion()
    then
