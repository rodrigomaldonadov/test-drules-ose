rule "R2365"
    when
        $ctx : CpeContext( documentoRelacionadoRepetido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2365", "El comprobante contiene un tipo y numero de Documento Relacionado repetido");
end


// Código 2367
rule "R2367"
    when
    	$ctx : CpeContext(priceAmountVentaFormatoInvalido == true )
    	$res : ResultadoValidacion()

    then
        $res.addError("2367", "El dato ingresado en PriceAmount del Precio de venta unitario por item no cumple con el formato establecido");
end


// Código 2369
rule "R2369"
    when
    	$ctx : CpeContext(priceAmountValorFormatoInvalido == true )
    	$res : ResultadoValidacion()
    then
        $res.addError("2369", "El dato ingresado en PriceAmount del Valor de venta unitario por item no cumple con el formato establecido");
end


// Código 2370
rule "R2370"
    when
        $ctx : CpeContext( lineExtensionAmountItemInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2370", "El dato ingresado en LineExtensionAmount del item no cumple con el formato establecido");
end


// Código 2371
rule "R2371"
    when
        $ctx : CpeContext( faltaTaxExemptionReasonCode == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2371", "El XML no contiene el tag cbc:TaxExemptionReasonCode de Afectacion al IGV");
end


// Código 2373
rule "R2373"
    when
        $ctx : CpeContext( iscSinSistemaCalculo == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2373", "Si existe monto de ISC en el ITEM debe especificar el sistema de calculo");
end


// Código 2377
rule "R2377"
    when
        $ctx : CpeContext( nameTaxTypeCodeIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2377", "El Name o TaxTypeCode debe corresponder al codigo de tributo del item");
end


// Código 2409
rule "R2409"
    when
        $ctx : CpeContext( alternativeConditionPriceDuplicado == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2409", "Existe mas de un tag cac:AlternativeConditionPrice con el mismo cbc:PriceTypeCode");
end


// Código 2410
rule "R2410"
    when
        $ctx : CpeContext( priceTypeCodeInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2410", "Se ha consignado un valor invalido en el campo cbc:PriceTypeCode");
end


// Código 2416
rule "R2416"
    when
        $ctx : CpeContext( leyendaTransferenciaGratuita == true,
                           totalValorVentaGratuitas <= 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2416", "Si existe leyenda Transferencia Gratuita debe consignar Total Valor de Venta de Operaciones Gratuitas");
end


// Código 2503
rule "R2503"
    when
        $ctx : CpeContext( paidAmountAnticipoNoPositivo == true )
        $res : ResultadoValidacion()
    then
