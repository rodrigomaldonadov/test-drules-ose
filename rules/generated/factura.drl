// Código 3219
rule "R3219"
    when
        $ctx : CpeContext( comprobanteAnticipoNoAutorizado == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3219", "El comprobante que se realizo el anticipo no se encuentra autorizado");
end


// Código 3220
rule "R3220"
    when
        $ctx : CpeContext( anticipoSinTotalAnticipos == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3220", "Si consigna montos de anticipo debe informar el Total de Anticipos");
end


// Código 3223
rule "R3223"
    when
        $ctx : CpeContext( combinacionTributosNoPermitida == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3223", "La combinacion de tributos no es permitida");
end


// Código 3224
rule "R3224"
    when
        $ctx : CpeContext( valorReferencialNoOnerosasinGratuita == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3224", "Si existe 'Valor referencial unitario en operac. no onerosas' con monto mayor a cero, la operacion debe ser gratuita (codigo de tributo 9996)");
end


// Código 3233
rule "R3233"
    when
        $ctx : CpeContext( cargoPercepcionSinMontoBase == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3233", "Para cargo Percepcion, debe ingresar monto base y debe ser mayor a 0.00");
end


// Código 3234
rule "R3234"
    when
        $ctx : CpeContext( codigoPrecio02NoGratuita == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3234", "El codigo de precio '02' es solo para operaciones gratuitas");
end


// Código 3236
rule "R3236"
    when
        $ctx : CpeContext(false)
        $res : ResultadoValidacion()
    then
        $res.addError("3236", "El valor ingresado en el campo cac:TaxSubtotal/cbc:BaseUnitMeasure no corresponde al valor esperado");
end


// Código 3237
rule "R3237"
    when
        $ctx : CpeContext(false)
        $res : ResultadoValidacion()
    then
        $res.addError("3237", "Debe consignar el campo cac:TaxSubtotal/cbc:BaseUnitMeasure a nivel de ítem");
end


// Código 3238
rule "R3238"
    when
        $ctx : CpeContext(false)
        $res : ResultadoValidacion()
    then
        $res.addError("3238", "El valor ingresado en el campo cac:TaxSubtotal/cbc:PerUnitAmount del ítem no corresponde al valor esperado");
end


// Código 3239
rule "R3239"
    when
        $ctx : CpeContext(false)
        $res : ResultadoValidacion()
    then
        $res.addError("3239", "El código de local anexo consignado no se encuentra declarado en el RUC");
end


// Código 3241
rule "R3241"
    when
        $ctx : CpeContext(
            tipoDocumentoReceptor != null,
            totalExonerado.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3241", "Para el tipo de operacion 2100, 2101 y 2102 (Creditos) debe consignar Numero de contrato, Fecha de otorgamiento y Monto del credito otorgado (capital)");
end


// Código 3242
rule "Para el tipo de operacion 2104 - Empresas del sistema de seguros, debe consignar Informacion adicional a nivel de item"
    when
        $ctx : CpeContext(
            totalGratuito != null,
            totalGratuito.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3242", "Para el tipo de operacion 2104 - Empresas del sistema de seguros, debe consignar Informacion adicional a nivel de item");
end


// Código 3243
rule "El XML no contiene tag o no existe informacion de la fecha del concepto por linea"
    when
        $ctx : CpeContext(
            esFactura == true,
            tipoDocCliente != null,
            tipoDocCliente != "6"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3243", "El XML no contiene tag o no existe informacion de la fecha del concepto por linea");
end


// Código 3244
rule "R3244"
    when
        $ctx : CpeContext( faltaTipoTransaccion == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3244", "Debe consignar la informacion del tipo de transaccion del comprobante");
end


// Código 3245
rule "R3245"
    when
        $ctx : CpeContext( faltaContadoOCredito == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3245", "Debe informar si el tipo de transaccion es al Contado o al Credito");
end


// Código 3246
rule "R3246"
    when
        $ctx : CpeContext( tipoTransaccionIdCuotaInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3246", "El tipo de transaccion o el identificador de la cuota no cumple con el formato esperado");
end


// Código 3247
rule "R3247"
    when
        $ctx : CpeContext( transaccionContadoYCredito == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3247", "El tipo de transaccion no puede ser a la vez al Contado y al Credito");
end


// Código 3248
rule "R3248"
    when
        $ctx : CpeContext( tipoTransaccionRepetido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3248", "El tipo de transaccion o el identificador de la cuota no debe repetirse en el comprobante");
end


// Código 3249
rule "R3249"
    when
        $ctx : CpeContext( esCredito == true,
                           sinCuotasDePago == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3249", "Si el tipo de transaccion es al Credito debe existir al menos informacion de una cuota de pago");
end


// Código 3250
rule "R3250"
    when
        $ctx : CpeContext( montoNetoPendienteInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3250", "El Monto neto pendiente de pago no cumple el formato definido");
end


// Código 3251
rule "R3251"
    when
        $ctx : CpeContext( esCredito == true,
                           faltaMontoNetoPendiente == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3251", "Si el tipo de transaccion es al Credito debe consignarse el Monto neto pendiente de pago");
end


// Código 3252
rule "R3252"
    when
        $ctx : CpeContext( cuotasSinTipoCredito == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3252", "Si existe informacion de cuota de pago, el tipo de transaccion debe ser al credito");
end


// Código 3253
rule "R3253"
    when
        $ctx : CpeContext( montoCuotaInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3253", "El Monto del pago unico o de las cuotas no cumple el formato definido");
end


// Código 3254
rule "R3254"
    when
        $ctx : CpeContext( cuotaSinMonto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3254", "Si se consigna informacion de la cuota de pago, debe indicarse el monto de la cuota");
end


// Código 3255
rule "R3255"
    when
        $ctx : CpeContext( fechaCuotaInvalida == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3255", "Fecha del pago unico o de las cuotas no cumple el formato definido");
end


// Código 3256
rule "R3256"
    when
        $ctx : CpeContext( cuotaSinFecha == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3256", "Si se consigna informacion de la cuota de pago, debe indicarse la fecha del pago unico o de las cuotas");
end


// Código 3258
rule "R3258"
    when
        $ctx : CpeContext(
            formaPago != null,
            formaPago.trim().length() > 0,
            formaPago not matches "Contado|Credito"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3258", "El valor de la forma de pago no es valido (Contado o Credito)");
end


// Código 3262
rule "R3262"
    when
        $ctx : CpeContext( tieneRetencionIgv == true,
                           receptorNoEsAgenteRetencion == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3262", "Si existe retencion de IGV en el comprobante, el receptor debe ser un Agente de Retencion");
end


// Código 3263
rule "R3263"
    when
        $ctx : CpeContext( importeRetencionIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3263", "El Importe de la retencion no tiene el valor correcto");
end


// Código 3264
rule "R3264"
    when
        $ctx : CpeContext( baseRetencionMayorTotal == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3264", "El importe total de la operacion (base imponible de retencion) no puede ser mayor al importe total del comprobante.");
end


// Código 3265
rule "R3265"
    when
        $ctx : CpeContext( montoNetoPendiente > total,
                           montoNetoPendiente > 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("3265", "El Monto neto pendiente de pago debe ser menor o igual al Importe total del comprobante");
end


// Código 3266
rule "R3266"
    when
        $ctx : CpeContext( montoCuotaMayorTotal == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3266", "El Monto del pago unico o de las cuotas debe ser menor o igual al Importe total del comprobante");
end


// Código 3267
rule "R3267"
    when
        $ctx : CpeContext( fechaCuotaAnteriorEmision == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3267", "Fecha del pago unico o de las cuotas no puede ser anterior o igual a la fecha de emision del comprobante");
end


// Código 3269
rule "R3269"
    when
        $ctx : CpeContext( tieneRetencionIgv == true,
                           emisorEsAgenteRetencion == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3269", "Si existe retencion de IGV en el comprobante, el emisor no debe ser un Agente de Retencion");
end


// Código 3270
rule "R3270"
    when
        $ctx : CpeContext( precioUnitarioDifiere == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3270", "El precio unitario de la operacion que esta informando difiere de los calculos realizados en base a la informacion remitida");
end


// Código 3271
rule "R3271"
    when
        $ctx : CpeContext( valorVentaItemDifiere == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3271", "El valor de venta por item difiere de los importes consignados.");
end


// Código 3272
rule "R3272"
    when
        $ctx : CpeContext( baseImponibleLineaDifiere == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3272", "La base imponible a nivel de linea difiere de la informacion consignada en el comprobante");
end


// Código 3273
rule "R3273"
    when
        $ctx : CpeContext( sumaVentaExportacionesLineaIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3273", "La sumatoria del total valor de venta - Exportaciones de linea no corresponden al total");
end


// Código 3274
rule "R3274"
    when
        $ctx : CpeContext( sumaVentaInafectasLineaIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3274", "La sumatoria del total valor de venta - operaciones inafectas de linea no corresponden al total");
end


