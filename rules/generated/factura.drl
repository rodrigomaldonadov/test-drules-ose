rule "R2054"
    when
        $ctx : CpeContext( faltaTaxSchemeNameGlobal == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2054", "El XML no contiene el tag TaxScheme Name de impuestos globales");
end


// Código 2062
rule "R2062"
    when
        $ctx : CpeContext(!DecimalUtils.formatoValido(total, 12, 2))
        $res : ResultadoValidacion()
    then
        $res.addError("2062", "El dato ingresado en PayableAmount no cumple con el formato establecido");
end


// Código 2064
rule "R2064"
    when
        $ctx : CpeContext( chargeTotalAmountFormatoInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2064", "El dato ingresado en ChargeTotalAmount no cumple con el formato establecido");
end


// Código 2065
rule "R2065"
    when
        $ctx : CpeContext( totalDescuentosFormatoInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2065", "El dato ingresado en el campo Total Descuentos no cumple con el formato establecido");
end


// Código 2068
rule "R2068"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext( valorUnitario == null ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2068", "El XML no contiene el tag cac:Price/cbc:PriceAmount en el detalle de los Items");
end


// Código 2070
rule "R2070"
    when
        $ctx : CpeContext( moneda == null || moneda.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2070", "El XML no contiene el tag o no existe informacion de DocumentCurrencyCode");
end


// Código 2071
rule "R2071"
    when
        $ctx : CpeContext( monedaInconsistente == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2071", "La moneda debe ser la misma en todo el documento. Salvo las percepciones que solo son en moneda nacional");
end


// Código 2072
rule "CustomizationID "
    when
        $ctx : CpeContext( customizationID != "2.0" )
        $res : ResultadoValidacion()
    then
        $res.addError("2072", "CustomizationID - La version del documento no es la correcta");
end


// Código 2073
rule "R2073"
    when
        $ctx : CpeContext( customizationID == null || customizationID.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2073", "El XML no existe informacion de CustomizationID");
end


// Código 2074
rule "R2074"
when
    $ctx : CpeContext(
        ublVersionId  != null,
        ublVersionId  != "2.1"
    )
    $res : ResultadoValidacion()
then
    $res.addError("2074", "UBLVersionID - La version del UBL no es correcta");
end


// Código 2075
rule "R2075"
    when
        $ctx : CpeContext( ublVersionId  == null || ublVersionId  == "" )
        $res : ResultadoValidacion()
    then
        $res.addError("2075", "El XML no contiene el tag o no existe informacion de UBLVersionID");
end


// Código 2108
rule "R2108"
    when
        $ctx : CpeContext(false)
        $res : ResultadoValidacion()
    then
        $res.addError("2108", "Presentacion fuera de fecha");
end


// Código 2109
rule "R2109"
    when
        $ctx : CpeContext(
            fechaVencimiento != null,
            fechaEmision != null,
            fechaVencimiento.isBefore( fechaEmision )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2109", "La fecha de vencimiento no puede ser anterior a la fecha de emision");
end


// Código 2118
rule "R2118"
    when
        $ctx : CpeContext(
            esNotaCredito == true,
            ( documentoRelacionado == null || documentoRelacionado.trim().length() == 0 )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2118", "Debe indicar las facturas relacionadas a la Nota de Credito");
end


// Código 2122
rule "R2122"
    when
        $ctx : CpeContext(
            ( esNotaCredito == true || esNotaDebito == true ),
            fechaDocumentoRelacionado == null
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2122", "Debe consignar la fecha del documento relacionado en la nota");
end


// Código 2123
rule "R2123"
    when
        $ctx : CpeContext(
            ( esNotaCredito == true || esNotaDebito == true ),
            fechaDocumentoRelacionado != null,
            fechaEmision != null,
            fechaDocumentoRelacionado.isAfter( fechaEmision )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2123", "La fecha del documento relacionado no puede ser posterior a la fecha de emision de la nota");
end


// Código 2127
rule "R2127"
    when
        $ctx : CpeContext(
            esNotaCredito == true,
            motivoNota != null,
            motivoNota not matches "0[1-9]|1[0-3]"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2127", "ResponseCode - El dato ingresado no cumple con la estructura");
end


// Código 2173
rule "R2173"
    when
        $ctx : CpeContext(
            esNotaDebito == true,
            motivoNota == null || motivoNota.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2173", "Debe consignar el motivo de la Nota de Debito (DiscrepancyResponse/Description)");
end


// Código 2174
rule "R2174"
    when
        $ctx : CpeContext(
            esNotaDebito == true,
            codigoMotivo == null || codigoMotivo.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2174", "Debe consignar el ResponseCode de la Nota de Debito");
end


// Código 2206
rule "R2206"
    when
        $ctx : CpeContext(
            esNotaDebito == true,
            ( documentoRelacionado == null || documentoRelacionado.trim().length() == 0 )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2206", "Debe indicar los documentos afectados por la Nota de Debito");
end


// Código 2329
rule "R2329"
    when
        $ctx : CpeContext(
            fechaEmision != null,
            fechaEmision.isAfter( LocalDate.now().plusDays(2) )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2329", "La fecha de emision se encuentra fuera del limite permitido");
end


// Código 2336
rule "R2336"
    when
        $ctx : CpeContext( firmaValida == false )
        $res : ResultadoValidacion()
    then
        $res.addError("2336", "Ocurrio un error en el proceso de validacion de la firma digital");
end


