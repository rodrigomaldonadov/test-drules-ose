// Código 3034
rule "R3034"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext(
            tipoAfectacionIGV == null || tipoAfectacionIGV.trim().length() == 0
        ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("3034", "El xml no contiene el tag o no existe informacion en el nro de cuenta de detraccion");
end


// Código 3035
rule "R3035"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext(
            tipoAfectacionIGV != null,
            tipoAfectacionIGV not matches "10|11|12|13|14|15|16|17|20|21|30|31|32|33|34|35|36|40"
        ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("3035", "El xml no contiene el tag o no existe informacion en el monto de detraccion");
end


