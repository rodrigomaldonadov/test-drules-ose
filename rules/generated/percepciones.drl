// Código 4086
rule "R4086"
    when
        $ctx : CpeContext(emisorYClienteSonAgentesPercepcionCombustible == true)
        $res : ResultadoValidacion()
    then
        $res.addError("4086", "El emisor y el cliente son Agentes de percepcion de combustible en la fecha de emision.");
        $ctx.marcarError(4086);
end


// Código 4089
rule "R4089"
    when
        $ctx : CpeContext(operacionExcluidaPercepcionPorRetencion == true)
        $res : ResultadoValidacion()
    then
        $res.addError("4089", "La operacion con este cliente esta excluida del sistema de percepcion. Es agente de retencion.");
        $ctx.marcarError(4089);
end

// Código 4090
rule "R4090"
    when
        $ctx : CpeContext(operacionExcluidaPercepcionPorEntidadExceptuada == true)
        $res : ResultadoValidacion()
    then
        $res.addError("4090", "La operacion con este cliente esta excluida del sistema de percepcion. Es entidad exceptuada de la percepcion.");
        $ctx.marcarError(4090);
end

// Código 4285
rule "R4285"
    when
        $ctx : CpeContext(emisorNoRegistradoHabilitadoAgentePercepcion == true)
        $res : ResultadoValidacion()
    then
        $res.addError("4285", "El emisor a la fecha no se encuentra registrado o habilitado con la condicion de Agente de percepcion.");
        $ctx.marcarError(4285);
end

