rule "R2661"
    when
        $ctx : CpeContext(false)
        $res : ResultadoValidacion()
    then
        $res.addError("2661", "La fecha de cobro de cada documento relacionado deben ser del mismo Periodo (mm/aaaa), asimismo estas fechas podrán ser menores o iguales a la fecha de emisión del comprobante de retencion");
end
