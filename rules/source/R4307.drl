rule "R4307"
    when
        $ctx : CpeContext(
            esBoleta == true,
            sumaDescuentosGlobalesIncorrecta == true
        )
        $res : ResultadoValidacion()
    then
        $res.addObservacion("4307", "La sumatoria consignados en descuentos globales no corresponden al total.");
        $ctx.marcarError(4307);
end