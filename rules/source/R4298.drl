rule "R4298"
    when
        $ctx : CpeContext(
            (esBoleta || esNotaCredito || esNotaDebito),
            sumaVentaGratuitasLineaIncorrecta == true
        )
        $res : ResultadoValidacion()
    then
        $res.addError("4298", "La sumatoria del total valor de venta - operaciones gratuitas de linea no corresponden al total.");
        $ctx.marcarError(4298);
end
