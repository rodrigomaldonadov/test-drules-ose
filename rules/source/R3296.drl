rule "R3296"
    when
        $ctx : CpeContext(
            totalISC != null,
            totalISC.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3296", "La sumatoria del monto base - ISC de linea no corresponden al total");
end
