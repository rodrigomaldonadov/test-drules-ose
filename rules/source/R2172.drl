rule "R2172"
    when
        $ctx : CpeContext(
            esNotaDebito == true,
            motivoNota != null,
            motivoNota not matches "0[1-3]"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2172", "ResponseCode - El dato ingresado no cumple con la estructura");
end
