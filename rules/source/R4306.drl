rule "R4306"
    when
        $ctx : CpeContext(
            eval( esBoleta == true || esNotaCredito == true || esNotaDebito == true ),
            sumaMontoOtrosTributosLineaNoCorrespondeTotal == true
        )
        $res : ResultadoValidacion()
    then
        $res.addObservacion("4306", "La sumatoria del total del importe del tributo Otros tributos de línea no corresponden al total.");
        $ctx.marcarError(4306);
end