rule "R2120"
    when
        $ctx : CpeContext(
            esNotaCredito == true,
            motivoNota == null || motivoNota.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2120", "Debe consignar el motivo de la Nota de Credito (DiscrepancyResponse/Description)");
end
