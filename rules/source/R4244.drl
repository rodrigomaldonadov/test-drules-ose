rule "R4244"
    when
        $ctx : CpeContext(leyenda2008SinOperacionesExoneradas == true)
        $res : ResultadoValidacion()
    then
        $res.addError("4244", "Si se utiliza la leyenda con codigo 2008, el total de operaciones exoneradas debe ser mayor a 0.00");
        $ctx.marcarError(4244);
end