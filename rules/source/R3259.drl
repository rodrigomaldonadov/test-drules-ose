rule "R3259"
    when
        $ctx : CpeContext(
	    formaPagoContado == true,
            numeroCuotas != null,
            numeroCuotas > 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3259", "No se deben informar cuotas cuando la forma de pago es Contado");
end
