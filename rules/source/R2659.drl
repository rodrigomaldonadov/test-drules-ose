rule "R2659"
    when
        $ctx : CpeContext(false)
        $res : ResultadoValidacion()
    then
        $res.addError("2659", "La fecha de cobro de cada documento relacionado deben ser del mismo Periodo (mm/aaaa), asimismo estas fechas podrán ser menores o iguales a la fecha de emisión del comprobante de percepción");
end
