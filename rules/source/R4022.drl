rule "R4022"
    when
        $ctx : CpeContext(leyenda2001SinOperacionesExoneradas == true)
        $res : ResultadoValidacion()
    then
        $res.addError("4022", "Si se utiliza la leyenda con codigo 2001, el total de operaciones exoneradas debe ser mayor a 0.00");
        $ctx.marcarError(4022);
end
