rule "Para el tipo de operacion 2104 - Empresas del sistema de seguros, debe consignar Informacion adicional a nivel de item"
    when
        $ctx : CpeContext(
            totalGratuito != null,
            totalGratuito.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3242", "Para el tipo de operacion 2104 - Empresas del sistema de seguros, debe consignar Informacion adicional a nivel de item");
end
