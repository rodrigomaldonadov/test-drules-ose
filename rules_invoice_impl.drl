 * [4335] OBSERVACIÓN — Tipo de estructura GS1 inválido
 */
rule "4335_tipo_estructura_gs1_invalido"
    when
        $ctx : CpeContext( tipoEstructuraGs1Invalido == true )
        $res : ResultadoValidacion()
    then
        $res.addObservacion("4335", "El tipo de estructura GS1 no tiene un valor permitido");
end

/**
 * [4254] OBSERVACIÓN — Atributo @listID del codigo de producto incorrecto
 * Tag: cac:Item/cac:CommodityClassification/cbc:ItemClassificationCode/@listID
 * Debe ser "UNSPSC" cuando el atributo esta presente.
 */
rule "4254_atributo_listid_producto_incorrecto"
    when
        $ctx : CpeContext( atributoListIdProductoIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addObservacion("4254", "El atributo @listID del codigo de producto no corresponde al valor UNSPSC");
end

/**
 * [2892] ERROR — Valor del tag con formato inválido
 */
rule "2892_valor_tag_formato_invalido"
    when
        $ctx : CpeContext( valorTagFormatoInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2892", "El valor del tag no cumple con el formato establecido");
end

/**
 * [2936] ERROR — Unidad de medida no corresponde al valor esperado
 */
rule "2936_unidad_medida_no_esperada"
    when
        $ctx : CpeContext( unidadMedidaNoEsperada == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2936", "El dato ingresado como unidad de medida no corresponde al valor esperado");
end

/**
 * [3007] ERROR — Código de tributo global no corresponde al esperado
 */
rule "3007_codigo_tributo_global_no_esperado"
    when
        $ctx : CpeContext( codigoTributoGlobalNoEsperado == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3007", "El dato ingresado como codigo de tributo global no corresponde al valor esperado.");
end

/**
 * [3496] ERROR — Código de producto SUNAT inválido
 */
rule "3496_codigo_producto_sunat_invalido"
    when
        $ctx : CpeContext( codigoProductoSunatInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3496", "El Codigo producto de SUNAT no es valido");
end





