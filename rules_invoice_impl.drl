 */
rule "2065_total_descuentos_formato_invalido"
    when
        $ctx : CpeContext( totalDescuentosFormatoInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2065", "El dato ingresado en el campo Total Descuentos no cumple con el formato establecido");
end

/**
 * [2071] ERROR — Moneda no es la misma en todo el documento
 */
rule "2071_moneda_inconsistente_documento"
    when
        $ctx : CpeContext( monedaInconsistente == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2071", "La moneda debe ser la misma en todo el documento. Salvo las percepciones que solo son en moneda nacional");
end

/**
 * [2075] ERROR — Falta UBLVersionID
 */
rule "2075_falta_ubl_version_id"
    when
        $ctx : CpeContext( ublVersionId  == null || ublVersionId  == "" )
        $res : ResultadoValidacion()
    then
        $res.addError("2075", "El XML no contiene el tag o no existe informacion de UBLVersionID");
end

/**
 * [2364] ERROR — Guía de remisión repetida
 */
rule "2364_guia_remision_repetida"
    when
        $ctx : CpeContext( guiaRemisionRepetida == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2364", "El comprobante contiene un tipo y numero de Guia de Remision repetido");
end

/**
 * [2365] ERROR — Documento relacionado repetido
 */
rule "2365_documento_relacionado_repetido"
    when
        $ctx : CpeContext( documentoRelacionadoRepetido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2365", "El comprobante contiene un tipo y numero de Documento Relacionado repetido");
end

rule "2367_price_amount_venta_formato_invalido"
    when
    	$ctx : CpeContext(priceAmountVentaFormatoInvalido == true )
    	$res : ResultadoValidacion()

    then
        $res.addError("2367", "El dato ingresado en PriceAmount del Precio de venta unitario por item no cumple con el formato establecido");
end

/**
 * [2369] ERROR — PriceAmount (valor venta unitario) con formato inválido
 */
rule "2369_price_amount_valor_formato_invalido"
    when
    	$ctx : CpeContext(priceAmountValorFormatoInvalido == true )
    	$res : ResultadoValidacion()
    then
        $res.addError("2369", "El dato ingresado en PriceAmount del Valor de venta unitario por item no cumple con el formato establecido");
end

/**
 * [2370] ERROR — LineExtensionAmount del item con formato inválido
 */
rule "2370_line_extension_amount_item_invalido"
    when
        $ctx : CpeContext( lineExtensionAmountItemInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2370", "El dato ingresado en LineExtensionAmount del item no cumple con el formato establecido");
end

/**
 * [2371] ERROR — Falta TaxExemptionReasonCode en línea
 */
rule "2371_falta_tax_exemption_reason_code"
    when
        $ctx : CpeContext( faltaTaxExemptionReasonCode == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2371", "El XML no contiene el tag cbc:TaxExemptionReasonCode de Afectacion al IGV");
end

/**
 * [2373] ERROR — ISC en item sin sistema de cálculo
 */
rule "2373_isc_sin_sistema_calculo"
    when
        $ctx : CpeContext( iscSinSistemaCalculo == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2373", "Si existe monto de ISC en el ITEM debe especificar el sistema de calculo");
end

/**
 * [2377] ERROR — Name o TaxTypeCode no corresponde al código de tributo
 */
rule "2377_name_tax_type_code_incorrecto"
    when
        $ctx : CpeContext( nameTaxTypeCodeIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2377", "El Name o TaxTypeCode debe corresponder al codigo de tributo del item");
end

/**
 * [2409] ERROR — Más de un AlternativeConditionPrice con mismo PriceTypeCode
 */
rule "2409_alternative_condition_price_duplicado"
    when
        $ctx : CpeContext( alternativeConditionPriceDuplicado == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2409", "Existe mas de un tag cac:AlternativeConditionPrice con el mismo cbc:PriceTypeCode");
end

/**
 * [2410] ERROR — PriceTypeCode inválido
 */
rule "2410_price_type_code_invalido"
    when
        $ctx : CpeContext( priceTypeCodeInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2410", "Se ha consignado un valor invalido en el campo cbc:PriceTypeCode");
end

/**
 * [2416] ERROR — Leyenda transferencia gratuita sin total valor venta gratuitas
 */
rule "2416_leyenda_gratuita_sin_total"
    when
        $ctx : CpeContext( leyendaTransferenciaGratuita == true,
                           totalValorVentaGratuitas <= 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2416", "Si existe leyenda Transferencia Gratuita debe consignar Total Valor de Venta de Operaciones Gratuitas");
end

/**
 * [2752] ERROR — Número de ítem duplicado
 */
rule "2752_numero_item_duplicado"
    when
        $ctx : CpeContext( itemNumeroDuplicado == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2752", "El numero de item no puede estar duplicado.");
end

/**
 * [2802] ERROR — Número de documento receptor con formato inválido
 */
rule "2802_numero_doc_receptor_formato_invalido"
    when
        $ctx : CpeContext( tipoDocumentoReceptor in ("4","7","0","A","B","C","D","E","G"),
                           numeroDocumentoReceptor != null,
                           numeroDocumentoReceptor not matches "^[a-zA-Z0-9]{1,15}$" )
        $res : ResultadoValidacion()
    then
        $res.addError("2802", "El dato ingresado como numero de documento de identidad del receptor no cumple con el formato establecido");
end

/**
 * [2883] ERROR — Falta unidad de medida del ítem ok
 */
rule "2883_falta_unidad_medida_item"
    when
        $ctx : CpeContext( faltaUnidadMedidaItem == true)
        $res : ResultadoValidacion()
    then
        $res.addError("2883", "Es obligatorio indicar la unidad de medida del item");
end

