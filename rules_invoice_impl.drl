 */
rule "3285_leyenda_2003_sin_exoneradas"
    when
        $ctx : CpeContext( tieneLeyenda2003 == true,
                           totalValorVentaExoneradas <= 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("3285", "Si se utiliza la leyenda con codigo 2003, el total de operaciones exoneradas debe ser mayor a 0.00");
end

