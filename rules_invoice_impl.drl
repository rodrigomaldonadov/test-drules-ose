/**
 * Reglas de Validación OSE/SUNAT - Factura Electrónica v2.0
 * Fuente: Reglas_de_Validación_actualizado_al_24_04_2026
 * Condiciones implementadas sobre: ose.rules.InvoiceContext
 *
 * Clasificación:
 *   ERR  0100-1999 → Excepciones (retorna excepción al emisor)
 *   ERR  2000-3999 → Errores que generan rechazo (CDR rechazada)
 *   OBSERV 4000+  → Observaciones (CDR aceptada con advertencia)
 */
package invoice

import ose.rules.DecimalUtils
import ose.rules.CpeContext
import ose.rules.LineaContext
import ose.model.ResultadoValidacion
import java.time.LocalDate
global ose.sunat.CatalogoSunatCacheBean catalogos

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 1 — DUPLICADO
// ═══════════════════════════════════════════════════════════════
/**
 * [1032] ERROR - Numeración
 * El comprobante ya está informado y se encuentra con estado anulado o rechazado.
 */
rule "1032_comprobante_anulado_o_rechazado"
    when
        $ctx : CpeContext( duplicado == true, esFactura == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1032", "El comprobante ya esta informado y se encuentra con estado anulado o rechazado");
end

/**
 * [1033] ERROR - Numeración
 * El comprobante fue registrado previamente con otros datos.
 * (Serie electrónica, estado = datos distintos)
 */
rule "1033_comprobante_registrado_con_otros_datos"
    when
        $ctx : CpeContext( duplicado == true, esFactura == false )
        $res : ResultadoValidacion()
    then
        $res.addError("1033", "El comprobante fue registrado previamente con otros datos");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 2 — FECHA DE EMISIÓN
// ═══════════════════════════════════════════════════════════════

/**
 * [2108] ERROR - Fecha de emisión
 * Tag: /Invoice/cbc:IssueDate
 * Condición: Para serie que NO inicia con número, la diferencia entre fecha de
 * recepción del XML y el valor del tag es mayor al plazo máximo vigente.
 * (Vigente como ERROR desde nov 2024)

rule "2108_presentacion_fuera_de_fecha"
    when
        $ctx : CpeContext(
            fechaEmision != null,
            fechaEmision.isBefore( LocalDate.now().minusDays(90) )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2108", "Presentacion fuera de fecha");
end */


/**
 * [2329] ERROR - Fecha de emisión
 * El valor del tag es mayor a dos días de la fecha de envío del comprobante.
 * Aplica para series que inician con número (físicas/contingencia).
 */
rule "2329_fecha_emision_futura_mayor_dos_dias"
    when
        $ctx : CpeContext(
            fechaEmision != null,
            fechaEmision.isAfter( LocalDate.now().plusDays(2) )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2329", "La fecha de emision se encuentra fuera del limite permitido");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 3 — TIPO DE DOCUMENTO
// ═══════════════════════════════════════════════════════════════

/**
 * [1004] ERROR - Tipo de documento
 * Tag: /Invoice/cbc:InvoiceTypeCode
 * No existe el Tag UBL o es vacío.
 */
rule "1004_tipo_documento_ausente"
    when
        $ctx : CpeContext( tipoDocumento == null || tipoDocumento.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("1004", "El XML no contiene el tag o no existe informacion de InvoiceTypeCode");
end
/**
 * [1003] ERROR - Tipo de documento
 * El valor del Tag UBL es diferente al tipo de documento del archivo.
 * Valores válidos para Factura: "01"
 */
rule "1003_tipo_documento_invalido_factura"
    when
        $ctx : CpeContext(
            tipoDocumento != null,
            tipoDocumento.trim().length() > 0,
            tipoArchivoDistintoXml == true
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1003", "InvoiceTypeCode - El valor del tipo de documento es invalido o no coincide con el nombre del archivo");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 4 — MONEDA
// ═══════════════════════════════════════════════════════════════

/**
 * [2070] ERROR - Tipo de moneda
 * Tag: /Invoice/cbc:DocumentCurrencyCode
 * No existe el Tag UBL o es vacío.
 */
rule "2070_moneda_ausente"
    when
        $ctx : CpeContext( moneda == null || moneda.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2070", "El XML no contiene el tag o no existe informacion de DocumentCurrencyCode");
end

/**
 * [3088] ERROR - Tipo de moneda
 * El valor del Tag UBL es diferente al listado (Catálogo 02).
 * Monedas válidas comunes: PEN, USD, EUR (catálogo ISO 4217)
 */
rule "3088_moneda_invalida"
    when
        $ctx : CpeContext(
            moneda != null,
            moneda.trim().length() > 0,
            moneda not matches "PEN|USD|EUR|GBP|JPY|CAD|CHF|AUD|BRL|MXN|CLP|COP|ARS|BOB|PYG|UYU|VES"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3088", "El valor ingresado como moneda del comprobante no es valido (catalogo nro 02).");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 5 — EMISOR (RUC)
// ═══════════════════════════════════════════════════════════════

rule "2010 - CPE contribuyente no esta activo"
salience 1000
when
    $ctx : CpeContext(contribuyenteNoActivo == true ) 
    $r : ResultadoValidacion()
then
    $r.addError("2010", "El contribuyente no esta activo");
end

/**
 * [1032] ERROR - Numeración
 * El comprobante ya está informado y se encuentra con estado anulado o rechazado.
 */


/**
 * [1008] ERROR - Número de RUC del emisor
 * Tag: @schemeID de AccountingSupplierParty
 * No existe el atributo o es vacío.
 */
rule "1008_schemeId_emisor_ausente"
    when
        $ctx : CpeContext(
            schemeIdEmisor == null || schemeIdEmisor.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1008", "El XML no contiene el tag o no existe informacion en tipo de documento del emisor.");
end

/**
 * [1007] ERROR - Número de RUC del emisor
 * El valor del Tag UBL es diferente a "6".
 */
rule "1007_schemeId_emisor_debe_ser_6"
    when
        $ctx : CpeContext(
            schemeIdEmisor != null,
            schemeIdEmisor.trim().length() > 0,
            schemeIdEmisor != "6"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1007", "El dato ingresado no cumple con el estandar");
end

/**
 * [1010] ERROR - Fecha de Emisión
 * El XML no contiene el tag IssueDate.
 */
rule "1010_El XML no contiene el tag IssueDate"
    when
        $ctx : CpeContext( faltaIssueDateGlobal == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1010", "El XML no contiene el tag IssueDate");
end

/**
 * [1011] ERROR - Fecha de Emisión
 * IssueDate - El dato ingresado no es válido.
 */
rule "1011_IssueDate no es valido"
    when
        $ctx : CpeContext( faltaIssueDateGlobal == false, issueDateValorInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1011", "IssueDate- El dato ingresado no es valido");
end


/**
 * [1012] ERROR - Numeración
 * ID - El dato ingresado no cumple con el patron SERIE-CORRELATIVO.
 */
rule "1012_ID no cumple con el patron SERIE-CORRELATIVO"
    when
        $ctx : CpeContext( formatoSerieCorrelativoInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1012", "ID - El dato ingresado no cumple con el patron SERIE-CORRELATIVO");
end
/**
 * [1037] ERROR - Razón social del emisor
 * Tag: cac:AccountingSupplierParty/cac:Party/cac:PartyLegalEntity/cbc:RegistrationName
 * No existe el Tag UBL o es vacío.
 */
rule "1037_razon_social_emisor_ausente"
    when
        $ctx : CpeContext(
            razonSocialEmisor == null || razonSocialEmisor.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1037", "El XML no contiene el tag o no existe informacion de RegistrationName del emisor del documento");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 6 — RECEPTOR (CLIENTE)
// ═══════════════════════════════════════════════════════════════

/**
 * [2014] ERROR - Tipo y número de documento del receptor
 * No existe el Tag UBL (número de documento del receptor).
 */
rule "2014_doc_receptor_ausente"
    when
        $ctx : CpeContext( docCliente == null || docCliente.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2014", "El XML no contiene el tag o no existe informacion del numero de documento de identidad del receptor del documento");
end

/**
 * [2015] ERROR - Tipo de documento de identidad del receptor
 * No existe el atributo @schemeID (tipo de documento).
 */
rule "2015_tipo_doc_receptor_ausente"
    when
        $ctx : CpeContext( tipoDocCliente == null || tipoDocCliente.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2015", "El XML no contiene el tag o no existe informacion del tipo de documento de identidad del receptor del documento");
end

/**
 * [2017] ERROR - Número de documento del receptor
 * Si tipo de documento es "6" (RUC), el formato debe ser numérico de 11 dígitos.
 */
rule "2017_ruc_receptor_formato_invalido"
    when
        $ctx : CpeContext(
            tipoDocCliente == "6",
            docCliente != null,
            docCliente not matches "\\d{11}"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2017", "El numero de documento de identidad del receptor debe ser RUC");
end

/**
 * [2801] ERROR - DNI del receptor
 * Si tipo de documento es "1" (DNI), el formato debe ser numérico de 8 dígitos.
 */
rule "2801_dni_receptor_formato_invalido"
    when
        $ctx : CpeContext(
            tipoDocCliente == "1",
            docCliente != null,
            docCliente not matches "\\d{8}"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2801", "El DNI ingresado no cumple con el estandar.");
end

/**
 * [2800] ERROR - Tipo de documento del receptor
 * Para operaciones de exportación (0200, 0201, 0204) sin leyenda 2008,
 * el tipo de doc del receptor debe ser "6" (RUC).
 */
rule "2800_tipo_doc_receptor_invalido_exportacion"
    when
        $ctx : CpeContext(
            tipoOperacion != null,
            tipoOperacion matches "0200|0201|0202|0203|0204|0205|0206|0207|0208|0401",
            tipoDocCliente != null,
            tipoDocCliente != "6"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2800", "El dato ingresado en el tipo de documento de identidad del receptor no esta permitido.");
end

/**
 * [2021] ERROR - Razón social del receptor
 * No existe el Tag UBL o es vacío.
 */
rule "2021_razon_social_receptor_ausente"
    when
        $ctx : CpeContext(
            nombreCliente == null || nombreCliente.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2021", "El XML no contiene el tag o no existe informacion de RegistrationName del receptor del documento");
end

/**
 * [2022] ERROR - Razón social del receptor
 * El formato del tag es diferente a alfanumérico de 3 hasta 1500 caracteres.
 */
rule "2022_razon_social_receptor_formato_invalido"
    when
        $ctx : CpeContext(
            nombreCliente != null,
            ( nombreCliente.trim().length() < 3 || nombreCliente.trim().length() > 1500 )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2022", "RegistrationName - El dato ingresado no cumple con el estandar");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 7 — FIRMA DIGITAL
// ═══════════════════════════════════════════════════════════════

/**
 * [2336] ERROR - Firma Digital
 * Error al procesar la validación de la firma digital.
 */
rule "2336_firma_digital_invalida"
    when
        $ctx : CpeContext( firmaValida == false )
        $res : ResultadoValidacion()
    then
        $res.addError("2336", "Ocurrio un error en el proceso de validacion de la firma digital");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 8 — TOTALES E IGV
// ═══════════════════════════════════════════════════════════════

/**
 * [2044] ERROR - PayableAmount (Total)
 * PayableAmount es obligatorio.
 */
rule "2044_total_obligatorio"
    when
        $ctx : CpeContext( total == null )
        $res : ResultadoValidacion()
    then
        $res.addError("2044", "PayableAmount es obligatorio");
end

/**
 * [2062] ERROR - El dato ingresado en PayableAmount no cumple con el formato establecido
 * El dato ingresado en PayableAmount no cumple con el formato establecido.
 */
rule "2062_El dato ingresado en PayableAmount no cumple con el formato establecido"
    when
        $ctx : CpeContext(!DecimalUtils.formatoValido(total, 12, 2))
        $res : ResultadoValidacion()
    then
        $res.addError("2062", "El dato ingresado en PayableAmount no cumple con el formato establecido");
end

/**
 * [3280] ERROR - Importe total
 * El importe total no coincide con el valor calculado
 * (subtotal + IGV + otros cargos − descuentos).
 */
rule "3280_total_no_consistente"
    when
        $ctx : CpeContext(
            total != null,
            totalConsistente == false
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3280", "El importe total del comprobante no coincide con el valor calculado");
end

/**
 * [2956] ERROR - Monto total de tributos
 * No existe el tag /Invoice/cac:TaxTotal.
 */
rule "2956_tax_total_obligatorio"
    when
        $ctx : CpeContext( taxamuntGlobal == null )
        $res : ResultadoValidacion()
    then
        $res.addError("2956", "El Monto total de impuestos es obligatorio");
end
/**
 * [3291] ERROR - IGV
 * El cálculo del IGV es incorrecto.  
 * igvConsistente = flag que debe resolverse al construir el contexto
 * (verificación: subtotal * tasa_igv == totalIGV, con tolerancia por redondeo).
 */
rule "3291_igv_inconsistente"
    when
        $ctx : CpeContext(
            		
            totalIGV != null,
            igvConsistente == false
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3291", "El calculo del IGV es Incorrecto");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 9 — TIPO DE OPERACIÓN
// ═══════════════════════════════════════════════════════════════

/**
 * [3205] ERROR - Tipo de operación
 * Tag: /Invoice/cbc:InvoiceTypeCode@listID
 * No existe el atributo o es vacío.
 */
rule "3205_tipo_operacion_ausente"
    when
        $ctx : CpeContext(
            tipoOperacion == null || tipoOperacion.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3205", "Debe consignar el tipo de operacion");
end

/**
 * [3206] ERROR - Tipo de operación
 * El valor del atributo es diferente al listado (catálogo 51) según el tipo de documento.
 * Tipos válidos para Factura (01): 0101, 0102, 0103, 0104, 0105, 0106, 0107, 0108,
 *   0109, 0110, 0111, 0112, 0113, 0120, 0121, 0200, 0201, ..., 2106, 1001-1004, 2001-2002
 */
rule "3206_tipo_operacion_invalido"
    when
        $ctx : CpeContext(
            tipoOperacion != null,
            tipoOperacion.trim().length() > 0,
            tipoOperacion not matches "0101|0102|0103|0104|0105|0106|0107|0108|0109|0110|0111|0112|0113|0120|0121|0200|0201|0202|0203|0204|0205|0206|0207|0208|0301|0302|0401|1001|1002|1003|1004|2001|2002|2003|2004|2100|2101|2102|2103|2104|2106"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3206", "El dato ingresado como tipo de operacion no corresponde a un valor esperado (catalogo nro. 51)");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 10 — NOTAS DE CRÉDITO Y DÉBITO
// ═══════════════════════════════════════════════════════════════

/**
 * [2118] ERROR - Nota de Crédito
 * Debe indicar las facturas relacionadas a la Nota de Crédito.
 */
rule "2118_nota_credito_sin_documento_relacionado"
    when
        $ctx : CpeContext(
            esNotaCredito == true,
            ( documentoRelacionado == null || documentoRelacionado.trim().length() == 0 )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2118", "Debe indicar las facturas relacionadas a la Nota de Credito");
end

/**
 * [2206] ERROR - Nota de Débito
 * Debe indicar los documentos afectados por la Nota de Débito.
 */
rule "2206_nota_debito_sin_documento_relacionado"
    when
        $ctx : CpeContext(
            esNotaDebito == true,
            ( documentoRelacionado == null || documentoRelacionado.trim().length() == 0 )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2206", "Debe indicar los documentos afectados por la Nota de Debito");
end

/**
 * [2127] ERROR - Nota de Crédito: ResponseCode
 * El dato ingresado (motivo) no cumple con la estructura (catálogo 09).
 * Valores válidos: 01-13
 */
rule "2127_motivo_nota_credito_invalido"
    when
        $ctx : CpeContext(
            esNotaCredito == true,
            motivoNota != null,
            motivoNota not matches "0[1-9]|1[0-3]"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2127", "ResponseCode - El dato ingresado no cumple con la estructura");
end

/**
 * [2172] ERROR - Nota de Débito: ResponseCode
 * El dato ingresado (motivo) no cumple con la estructura (catálogo 10).
 * Valores válidos: 01-03
 */
rule "2172_motivo_nota_debito_invalido"
    when
        $ctx : CpeContext(
            esNotaDebito == true,
            motivoNota != null,
            motivoNota not matches "0[1-3]"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2172", "ResponseCode - El dato ingresado no cumple con la estructura");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 11 — DETALLE / LÍNEAS
// ═══════════════════════════════════════════════════════════════

/**
 * [2026] ERROR - Descripción del ítem
 * No existe el Tag UBL cac:Item/cbc:Description o es vacío.
 * Se delega a validación de cada LineaContext.
 * Requiere from sobre la colección de lineas.
 */
rule "2026_descripcion_item_ausente"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext(
            descripcion == null || descripcion.trim().length() == 0
        ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2026", "El XML no contiene el tag cac:Item/cbc:Description en el detalle de los Items");
end

/**
 * [2024] ERROR - Cantidad de unidades por ítem
 * No existe el Tag InvoicedQuantity o es cero.
 */
rule "2024_cantidad_item_cero_o_ausente"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext(
            cantidad == null || cantidad.compareTo( java.math.BigDecimal.ZERO ) <= 0
        ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2024", "El XML no contiene el tag InvoicedQuantity en el detalle de los Items o es cero (0)");
end

/**
 * [2068] ERROR - Valor unitario por ítem
 * No existe el Tag cac:Price/cbc:PriceAmount.
 */
rule "2068_valor_unitario_ausente"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext( valorUnitario == null ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2068", "El XML no contiene el tag cac:Price/cbc:PriceAmount en el detalle de los Items");
end
// ═══════════════════════════════════════════════════════════════
// SECCIÓN 12 — SUBTOTAL (LineExtensionAmount)
// ═══════════════════════════════════════════════════════════════

/**
 * [3288] ERROR - Total valor de venta
 * Debe consignar el Total Valor de Venta (LineExtensionAmount global).
 */
rule "3288_subtotal_obligatorio"
    when
        $ctx : CpeContext( subtotal == null )
        $res : ResultadoValidacion()
    then
        $res.addError("3288", "Debe consignar el Total Valor de Venta");
end

/**
 * [2031] ERROR - El dato ingresado en total valor de venta no cumple con el estandar
 * El formato del Tag UBL es diferente de decimal positivo.
 */
rule "2031_El dato ingresado en total valor de venta no cumple con el estandar"
    when
        $ctx : CpeContext(!DecimalUtils.formatoValido(subtotal, 12, 2))
        $res : ResultadoValidacion()
    then
        $res.addError("2031", "El dato ingresado en total valor de venta no cumple con el estandar");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 13 — CustomizationID / UBLVersionID
// ═══════════════════════════════════════════════════════════════

/**
 * [1001] ERROR — El dato SERIE-CORRELATIVO no cumple con el formato de acuerdo al tipo de comprobante

 */
rule "1001_El dato SERIE-CORRELATIVO no cumple con el formato "
    when
        $ctx : CpeContext( formatoSerieCorrelativoInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1001", "ID - El dato SERIE-CORRELATIVO no cumple con el formato de acuerdo al tipo de comprobante");
end


/**
 * [1002] ERROR — CustomizationID ausente o invalido
 * Tag: /Invoice/cbc:CustomizationID
 * Valor esperado: "2.0"
 */
rule "1002_customization_id_ausente"
    when
        $ctx : CpeContext( customizationID == null || customizationID.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("1002", "El XML no contiene el tag CustomizationID o es vacio");
end

rule "1002_customization_id_invalido"
    when
        $ctx : CpeContext(
            customizationID != null,
            customizationID.trim().length() > 0,
            customizationID != "2.0"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1002", "CustomizationID - El valor del tag es diferente a 2.0");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 14 — SERIE Y NUMERO
// ═══════════════════════════════════════════════════════════════

/**
 * [1017] ERROR — Serie del comprobante ausente
 * Tag: /Invoice/cbc:ID (parte antes del guion)
 */
rule "1017_serie_ausente"
    when
        $ctx : CpeContext( serie == null || serie.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("1017", "El XML no contiene el tag ID o la serie esta vacia");
end

/**
 * [1018] ERROR — Serie de factura debe iniciar con "F"
 * Catalogo: Facturas → F001-F999
 */
rule "1018_serie_factura_invalida"
    when
        $ctx : CpeContext(
            esFactura == true,
            serie != null,
            serie.trim().length() > 0,
            serie not matches "^[Ff]\\d{3}$"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1018", "La serie del comprobante no cumple con el formato para Factura (Fxxx)");
end

/**
 * [1018] ERROR — Serie de boleta debe iniciar con "B"
 */
rule "1018_serie_boleta_invalida"
    when
        $ctx : CpeContext(
            esBoleta == true,
            serie != null,
            serie.trim().length() > 0,
            serie not matches "^[Bb]\\d{3}$"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1018", "La serie del comprobante no cumple con el formato para Boleta (Bxxx)");
end

/**
 * [1019] ERROR — Numero de comprobante ausente o fuera de rango
 * El numero debe ser entero positivo de 1 a 99999999.
 */
rule "1019_numero_ausente"
    when
        $ctx : CpeContext( numero == null || numero.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("1019", "El XML no contiene el numero de comprobante o es vacio");
end

rule "1019_numero_formato_invalido"
    when
        $ctx : CpeContext(
            numero != null,
            numero.trim().length() > 0,
            numero not matches "^[0-9]\\d{0,7}$"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("1019", "El numero de comprobante no cumple con el formato (1 a 99999999)");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 15 — FECHA DE VENCIMIENTO
// ═══════════════════════════════════════════════════════════════

/**
 * [2109] ERROR — Fecha de vencimiento anterior a fecha de emision
 * Tag: /Invoice/cbc:DueDate
 * Aplica cuando la forma de pago es "Credito".
 */
rule "2109_fecha_vencimiento_anterior_a_emision"
    when
        $ctx : CpeContext(
            fechaVencimiento != null,
            fechaEmision != null,
            fechaVencimiento.isBefore( fechaEmision )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2109", "La fecha de vencimiento no puede ser anterior a la fecha de emision");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 16 — DIRECCION DEL EMISOR
// ═══════════════════════════════════════════════════════════════

/**
 * [2072] ERROR — CustomizationID - La versión del documento no es la correcta
 * Tag: 
 */
rule "CustomizationID "
    when
        $ctx : CpeContext( customizationID != "2.0" )
        $res : ResultadoValidacion()
    then
        $res.addError("2072", "CustomizationID - La version del documento no es la correcta");
end
/**
 * [2073] ERROR — El XML no existe informacion de CustomizationID
 * Tag: 
 */
rule "2073_El XML no existe informacion de CustomizationID"
    when
        $ctx : CpeContext( customizationID == null || customizationID.trim().length() == 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2073", "El XML no existe informacion de CustomizationID");
end

/**
 * [2074] ERROR — Codigo de pais del emisor ausente o invalido
 * Tag: cac:Country/cbc:IdentificationCode
 * Valor esperado para Peru: "PE"
 */
rule "2074_La version del UBL no es correcta"
when
    $ctx : CpeContext(
        ublVersionId  != null,
        ublVersionId  != "2.1"
    )
    $res : ResultadoValidacion()
then
    $res.addError("2074", "UBLVersionID - La version del UBL no es correcta");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 17 — TOTALES DESAGREGADOS
// ═══════════════════════════════════════════════════════════════

/**
 * [3240] ERROR — Total operaciones inafectas negativo
 */
rule "3240_total_inafecto_negativo"
    when
        $ctx : CpeContext(
            totalInafecto != null,
            totalInafecto.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3240", "El total de operaciones inafectas no puede ser negativo");
end

/**
 * [3241] ERROR — Para el tipo de operacion 2100, 2101 y 2102 (Creditos) debe consignar Numero de contrato, Fecha de otorgamiento y Monto del credito otorgado (capital)
 */
rule "3241_tPara el tipo de operacion 2100, 2101 y 2102 (Creditos) debe consignar Numero de contrato, Fecha de otorgamiento y Monto del credito otorgado (capital)"
    when
        $ctx : CpeContext(
            tipoDocumentoReceptor != null,
            totalExonerado.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3241", "Para el tipo de operacion 2100, 2101 y 2102 (Creditos) debe consignar Numero de contrato, Fecha de otorgamiento y Monto del credito otorgado (capital)");
end

/**
 * [3242] ERROR — Para el tipo de operacion 2104 - Empresas del sistema de seguros, debe consignar Informacion adicional a nivel de item
 */
rule "Para el tipo de operacion 2104 - Empresas del sistema de seguros, debe consignar Informacion adicional a nivel de item"
    when
        $ctx : CpeContext(
            totalGratuito != null,
            totalGratuito.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3242", "Para el tipo de operacion 2104 - Empresas del sistema de seguros, debe consignar Informacion adicional a nivel de item");
end

/**
 * [3296] ERROR — ISC negativo
 * Tag: TaxTotal con TaxCategory/ID = "2000" (ISC)
 */
rule "3296_total_isc_negativo"
    when
        $ctx : CpeContext(
            totalISC != null,
            totalISC.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3296", "La sumatoria del monto base - ISC de linea no corresponden al total");
end

/**
 * [3297] ERROR — Otros tributos negativo
 * Tag: TaxTotal con TaxCategory/ID = "9999" (otros tributos)
 */
rule "3297_total_otros_tributos_negativo"
    when
        $ctx : CpeContext(
            totalOtrosTributos != null,
            totalOtrosTributos.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3297", "La sumatoria del monto base - Otros tributos de linea no corresponden al total");
end

/**
 * [3298] ERROR — sumatoria del total del importe del tributo ISC 
 */
rule "sumatoria del total del importe del tributo ISC "
    when

        $ctx : CpeContext(
            totalISC != null,
            totalISC.compareTo( java.math.BigDecimal.ZERO ) > 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3298", "La sumatoria del total del importe del tributo ISC de linea no corresponden al total");
end

/**
 * [3243] ERROR — El XML no contiene tag o no existe informacion de la fecha del concepto por linea
 * Para factura (01), el receptor debe tener RUC (tipo "6").
 */
rule "El XML no contiene tag o no existe informacion de la fecha del concepto por linea"
    when
        $ctx : CpeContext(
            esFactura == true,
            tipoDocCliente != null,
            tipoDocCliente != "6"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3243", "El XML no contiene tag o no existe informacion de la fecha del concepto por linea");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 18 — DESCUENTOS Y CARGOS GLOBALES
// ═══════════════════════════════════════════════════════════════

/**
 * [3244] ERROR —Debe consignar la informacion del tipo de transaccion del comprobante
 * Tag: cac:AllowanceCharge (ChargeIndicator = false) a nivel cabecera
 */
rule "3244_Debe consignar la informacion del tipo de transaccion del comprobante"
    when
        $ctx : CpeContext(
            totalDescuentos != null,
            totalDescuentos.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3244", "Debe consignar la informacion del tipo de transaccion del comprobante");
end

/**
 * [3245] ERROR —Debe informar si el tipo de transaccion es al Contado o al Credito
 */
rule "3245_Debe informar si el tipo de transaccion es al Contado o al Credito"
    when
        $ctx : CpeContext(
            totalCargos != null,
            totalCargos.compareTo( java.math.BigDecimal.ZERO ) < 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3245", "Debe informar si el tipo de transaccion es al Contado o al Credito");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 19 — NOTA DE CREDITO/DEBITO: DOCUMENTO RELACIONADO EXTENDIDO
// ═══════════════════════════════════════════════════════════════

/**
 * [2119] ERROR — Tipo de documento relacionado invalido en Nota de Credito
 * El tipo debe corresponder a Factura (01) o Boleta (03) principalmente.
 * Catalogo 01 de SUNAT.
 */
rule "2119_tipo_doc_relacionado_nota_credito_invalido"
    when
        $ctx : CpeContext(
            esNotaCredito == true,
            $tipoDoc : tipoDocumentoRelacionado != null
        )
        eval(
            !catalogos.existeCodigo("01", $tipoDoc) 
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2119", "El tipo de documento relacionado en la Nota de Credito no es valido (catalogo nro. 01)");
end

/**
 * [2207] ERROR — Tipo de documento relacionado invalido en Nota de Debito
 */
rule "2207_tipo_doc_relacionado_nota_debito_invalido"
when
    $ctx : CpeContext(
        esNotaDebito == true,
        $tipoDoc : tipoDocumentoRelacionado != null
    )
    eval(
        !catalogos.existeCodigo("01", $tipoDoc)
    )
    $res : ResultadoValidacion()
then
    $res.addError( "2207", "El tipo de documento relacionado en la Nota de Debito no es valido (catalogo nro. 01)");
end
/**
 * [2120] ERROR — Motivo de nota de credito ausente
 * Tag: cac:DiscrepancyResponse/cbc:Description
 */
rule "2120_motivo_nota_credito_ausente"
    when
        $ctx : CpeContext(
            esNotaCredito == true,
            motivoNota == null || motivoNota.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2120", "Debe consignar el motivo de la Nota de Credito (DiscrepancyResponse/Description)");
end

/**
 * [2173] ERROR — Motivo de nota de debito ausente
 */
rule "2173_motivo_nota_debito_ausente"
    when
        $ctx : CpeContext(
            esNotaDebito == true,
            motivoNota == null || motivoNota.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2173", "Debe consignar el motivo de la Nota de Debito (DiscrepancyResponse/Description)");
end

/**
 * [2121] ERROR — Codigo de motivo (ResponseCode) ausente en Nota de Credito
 * Tag: cac:DiscrepancyResponse/cbc:ResponseCode
 */
rule "2121_codigo_motivo_nota_credito_ausente"
    when
        $ctx : CpeContext(
            esNotaCredito == true,
            codigoMotivo == null || codigoMotivo.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2121", "Debe consignar el ResponseCode de la Nota de Credito");
end

/**
 * [2174] ERROR — Codigo de motivo (ResponseCode) ausente en Nota de Debito
 */
rule "2174_codigo_motivo_nota_debito_ausente"
    when
        $ctx : CpeContext(
            esNotaDebito == true,
            codigoMotivo == null || codigoMotivo.trim().length() == 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2174", "Debe consignar el ResponseCode de la Nota de Debito");
end

/**
 * [2122] ERROR — Fecha del documento relacionado ausente
 * Tag: cac:BillingReference/cac:InvoiceDocumentReference/cbc:IssueDate
 */
rule "2122_fecha_doc_relacionado_ausente"
    when
        $ctx : CpeContext(
            ( esNotaCredito == true || esNotaDebito == true ),
            fechaDocumentoRelacionado == null
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2122", "Debe consignar la fecha del documento relacionado en la nota");
end

/**
 * [2123] ERROR — Fecha del documento relacionado futura
 * No puede ser posterior a la fecha de emision de la nota.
 */
rule "2123_fecha_doc_relacionado_futura"
    when
        $ctx : CpeContext(
            ( esNotaCredito == true || esNotaDebito == true ),
            fechaDocumentoRelacionado != null,
            fechaEmision != null,
            fechaDocumentoRelacionado.isAfter( fechaEmision )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("2123", "La fecha del documento relacionado no puede ser posterior a la fecha de emision de la nota");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 20 — LINEAS: TIPO AFECTACION IGV, CODIGO PRODUCTO, UNIDAD
// ═══════════════════════════════════════════════════════════════

/**
 * [3034] ERROR — El xml no contiene el tag o no existe información en el nro de cuenta de detracción
 */
rule "3034_El xml no contiene el tag o no existe información en el nro de cuenta de detracción"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext(
            tipoAfectacionIGV == null || tipoAfectacionIGV.trim().length() == 0
        ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("3034", "El xml no contiene el tag o no existe informacion en el nro de cuenta de detraccion");
end

/**
 * [3035] ERROR — El xml no contiene el tag o no existe información en el monto de detraccion
 */
rule "3035_El xml no contiene el tag o no existe información en el monto de detraccion"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext(
            tipoAfectacionIGV != null,
            tipoAfectacionIGV not matches "10|11|12|13|14|15|16|17|20|21|30|31|32|33|34|35|36|40"
        ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("3035", "El xml no contiene el tag o no existe informacion en el monto de detraccion");
end

/**
 * [2025] ERROR —InvoicedQuantity El dato ingresado no cumple con el estandar
 */
rule "2025_InvoicedQuantity El dato ingresado no cumple con el estandar"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext(!DecimalUtils.formatoValido(cantidad, 12, 10)) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2025", "InvoicedQuantity El dato ingresado no cumple con el estandar");
end

/**
 * [2027] ERROR — El XML no contiene el tag o no existe informacion de cac:Item/cbc:Description del item
 */
rule "2027_El XML no contiene el tag o no existe informacion de cac:Item/cbc:Description del item"
    when
        $ctx : CpeContext(lineas != null )
        $linea : LineaContext( descripcion == null, descripcion.trim().length() > 500 ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2027", "El XML no contiene el tag o no existe informacion de cac:Item/cbc:Description del item");
end


/**
 * [2029] ERROR — Precio de venta unitario ausente (PriceAmount con priceTypeCode 01)
 * Tag: cac:Price/cbc:PriceAmount
 */
rule "2029_precio_venta_unitario_ausente"
    when
        $ctx : CpeContext( lineas != null )
        $linea : LineaContext( precioUnitario == null ) from $ctx.getLineas()
        $res : ResultadoValidacion()
    then
        $res.addError("2029", "El XML no contiene el precio de venta unitario (PriceAmount con priceTypeCode 01)");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 21 — FORMA DE PAGO Y CUOTAS
// ═══════════════════════════════════════════════════════════════

/**
 * [3258] ERROR — Forma de pago con valor invalido
 * Valores permitidos: "Contado", "Credito"
 */
rule "3258_forma_pago_invalida"
    when
        $ctx : CpeContext(
            formaPago != null,
            formaPago.trim().length() > 0,
            formaPago not matches "Contado|Credito"
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3258", "El valor de la forma de pago no es valido (Contado o Credito)");
end

/**
 * [3259] ERROR — Cuotas informadas para pago al contado
 * Si la forma de pago es "Contado" no deben existir cuotas.
 */
rule "3259_cuotas_en_pago_contado"
    when
        $ctx : CpeContext(
	    formaPagoContado == true,
            numeroCuotas != null,
            numeroCuotas > 0
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3259", "No se deben informar cuotas cuando la forma de pago es Contado");
end

/**
 * [3260] ERROR — Pago al credito sin cuotas informadas
 */
rule "3260_credito_sin_cuotas"
    when
        $ctx : CpeContext(
	    esCredito == true,
            ( numeroCuotas == null || numeroCuotas == 0 )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3260", "Debe consignar al menos una cuota cuando la forma de pago es Credito");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 22 — DETRACCION
// ═══════════════════════════════════════════════════════════════

/**
 * [4008] OBSERVACION — Monto de detraccion no informado
 * Aplica a facturas con tipo de operacion sujeta a detraccion (ej. 1001-1004, 2001-2004).
 */
rule "4008_detraccion_obligatoria_por_tipo_operacion"
    when
        $ctx : CpeContext(
            tipoOperacion != null,
            tipoOperacion matches "1001|1002|1003|1004|2001|2002|2003|2004",
            ( codigoDetraccion == null || codigoDetraccion.trim().length() == 0 )
        )
        $res : ResultadoValidacion()
    then
        $res.addObservacion("4008", "El tipo de operacion informado requiere datos de detraccion");
end

/**
 * [3050] ERROR — Porcentaje de detraccion fuera de rango
 * El porcentaje debe estar entre 1.00 y 15.00 segun catalogo SUNAT.
 */
rule "3050_porcentaje_detraccion_invalido"
    when
        $ctx : CpeContext(
            porcentajeDetraccion != null,
            ( porcentajeDetraccion.compareTo( new java.math.BigDecimal("1.00") ) < 0 ||
              porcentajeDetraccion.compareTo( new java.math.BigDecimal("15.00") ) > 0 )
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3050", "Afectacion de IGV no corresponde al codigo de tributo de la linea.");
end

/**
 * [3051] ERROR — Monto de detraccion inconsistente
 * El monto de detraccion debe ser igual a total * porcentajeDetraccion / 100, con tolerancia ±1.
 */
rule "3051_monto_detraccion_inconsistente"
    when
        $ctx : CpeContext(
            detraccionConsistente == false,
            codigoDetraccion != null
        )
        $res : ResultadoValidacion()
    then
        $res.addError("3051", "Nombre de tributo no corresponde al codigo de tributo de la linea.");
end

// ═══════════════════════════════════════════════════════════════
// SECCION 23 — GUIAS DE REFERENCIA
// ═══════════════════════════════════════════════════════════════

/**
 * [4052] OBSERVACION — Serie de guia de referencia con formato invalido
 * Tag: cac:DespatchDocumentReference/cbc:ID
 * El ID de guia debe tener formato Txxx-xxxxxxxx.
 */
rule "4052_guia_referencia_formato_invalido"
    when
        $ctx : CpeContext( guiaReferencia != null )
        $guia : String(
            this != null,
            !this.matches("^[Tt]\\d{3}-\\d{1,8}$")
        ) from $ctx.getGuiaReferencia()
        $res : ResultadoValidacion()
    then
        $res.addObservacion("4052", "El ID de la guia de remision referenciada no cumple con el formato (Txxx-xxxxxxxx)");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 24 — ARCHIVO / NOMBRE DEL DOCUMENTO
// ═══════════════════════════════════════════════════════════════

/**
 * [1034] ERROR — RUC del archivo no coincide con el del XML
 */
rule "1034_ruc_archivo_distinto_xml"
    when
        $ctx : CpeContext( rucArchivoDistintoXml == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1034", "Numero de RUC del nombre del archivo no coincide con el consignado en el contenido del archivo XML");
end

/**
 * [1035] ERROR — Serie del archivo no coincide con el del XML
 */
rule "1035_serie_archivo_distinta_xml"
    when
        $ctx : CpeContext( serieArchivoDistintaXml == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1035", "Numero de Serie del nombre del archivo no coincide con el consignado en el contenido del archivo XML");
end

/**
 * [1036] ERROR — Número del archivo no coincide con el del XML
 */
rule "1036_numero_archivo_distinto_xml"
    when
        $ctx : CpeContext( numeroArchivoDistintoXml == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1036", "Numero de documento en el nombre del archivo no coincide con el consignado en el contenido del XML");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 25 — HABILITACIÓN DEL EMISOR
// ═══════════════════════════════════════════════════════════════

/**
 * [1078] ERROR — Emisor obligado a emitir por SEE-SOL no puede usar OSE
 */
rule "1078_emisor_obligado_see_sol"
    when
        $ctx : CpeContext( emisorObligadoSeeSol == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1078", "El emisor no se encuentra autorizado a emitir en el SEE-Desde los sistemas del contribuyente");
end

/**
 * [1080] ERROR — Emisor debe usar SEE-Empresas supervisadas
 */
rule "1080_emisor_debe_usar_see_empresas_supervisadas"
    when
        $ctx : CpeContext( tipoOperacion != null,
                           tipoOperacion in ("2100","2101","2102","2103","2104","0112"),
                           emisorAfiliadoEmpresasSupervisadas == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1080", "Debe enviar su comprobante por el SEE-Empresas supervisadas");
end

/**
 * [1083] ERROR — RUC del receptor no existe en el padrón
 */
rule "1083_ruc_receptor_no_existe"
    when
        $ctx : CpeContext( tipoDocumentoReceptor == "6",
                           rucReceptorNoExiste == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1083", "El numero de RUC del receptor no existe");
end

/**
 * [1086] ERROR — Emisor es SSCO (Sujeto sin capacidad operativa)
 */
rule "1086_emisor_ssco"
    when
        $ctx : CpeContext( emisorEsSsco == true )
        $res : ResultadoValidacion()
    then
        $res.addError("1086", "El emisor electronico es un Sujeto sin capacidad operativa (SSCO)");
end

// ═══════════════════════════════════════════════════════════════
// SECCIÓN 26 — ITEMS / LÍNEAS DE DETALLE
// ═══════════════════════════════════════════════════════════════

/**
 * [2023] ERROR — Número de orden del item inválido
 */
rule "2023_numero_orden_item_invalido"
    when
        $linea : LineaContext( numeroItem == null || numeroItem <= 0 || numeroItem != posicionLinea )
        $res : ResultadoValidacion()
    then
        $res.addError("2023", "El Numero de orden del item no cumple con el formato establecido");
end

/**
 * [2028] ERROR — Falta cac:AlternativeConditionPrice en línea
 */
rule "2028_falta_alternative_condition_price"
    when
        $ctx : CpeContext( faltaAlternativeConditionPrice == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2028", "Debe existir el tag cac:AlternativeConditionPrice");
end

/**
 * [2033] ERROR — TaxAmount de línea con formato inválido
 */
rule "2033_tax_amount_linea_formato_invalido"
    when
        $ctx : CpeContext( taxAmountLineaFormatoInvalido == true )   // <-- corregido
        $res : ResultadoValidacion()
    then
        $res.addError("2033", "El dato ingresado en TaxAmount de la linea no cumple con el formato establecido");
end

/**
 * [2036] ERROR — Código de tributo de línea inválido ok
 */
rule "2036_codigo_tributo_linea_invalido"
    when
        $ctx : CpeContext( codigoTributoLineaInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2036", "El codigo del tributo es invalido");
end

/**
 * [2037] ERROR — Falta cac:TaxCategory/cac:TaxScheme/cbc:ID en línea ok
 */
rule "2037_falta_tax_scheme_id_linea"
    when
        $ctx : CpeContext( faltaTaxSchemeIdLinea == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2037", "El XML no contiene el tag cac:TaxCategory/cac:TaxScheme/cbc:ID del Item");
end

/**
 * [2040] ERROR — Tipo de afectación IGV incorrecto
 */
rule "2040_tipo_afectacion_igv_incorrecto"
    when
        $ctx : CpeContext( tipoAfectacionIgvIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2040", "El tipo de afectacion del IGV es incorrecto");
end

