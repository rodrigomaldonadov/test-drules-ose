 * [2955] ERROR — Formato de Amount en cargo/descuento de línea inválido
 */
rule "2955_format_amount_cargo_desc_linea_invalido"
    when
        $ctx : CpeContext( formatoAmountCargDescLineaInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2955", "El formato ingresado en el tag cac:InvoiceLine/cac:Allowancecharge/cbc:Amount no cumple con el formato establecido");
end

/**
 * [2961] ERROR — Código tributo internacional incorrecto
 */
rule "2961_codigo_tributo_internacional_incorrecto"
    when
        $ctx : CpeContext( codigoTributoInternacionalIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2961", "El valor del tag codigo de tributo internacional no corresponde al esperado.");
end

/**
 * [2964] ERROR — Nombre tributo incorrecto
 */
rule "2964_nombre_tributo_incorrecto"
    when
        $ctx : CpeContext( nombreTributoIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2964", "El valor del tag nombre del tributo no corresponde al esperado.");
end

/**
 * [2968] ERROR — AllowanceCharge Amount con formato inválido
 */
rule "2968_allowance_charge_amount_invalido"
    when
        $ctx : CpeContext( allowanceChargeAmountFormatoInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2968", "El dato ingresado en cac:AllowanceCharge/cbc:Amount no cumple con el formato establecido.");
end

/**
 * [2992] ERROR — Falta tasa del tributo en línea
 */
rule "2992_falta_tasa_tributo_linea"
    when
        $ctx : CpeContext( faltaTasaTributoLinea == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2992", "El XML no contiene el tag de la tasa del tributo de la linea");
end

/**
 * [2993] ERROR — Factor IGV por línea igual a 0.00
 */
rule "2993_factor_igv_linea_cero"
    when
        $ctx : CpeContext( factorIgvLineaCero == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2993", "El factor de afectacion de IGV por linea debe ser diferente a 0.00.");
end

/**
 * [2996] ERROR — Falta nombre de tributo en línea
 */
rule "2996_falta_nombre_tributo_linea"
    when
        $ctx : CpeContext( faltaNombreTributoLinea == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2996", "El XML no contiene el tag o no existe informacion del nombre de tributo de la linea");
end

