// SECCIÓN 31 — PERCEPCIONES Y RETENCIONES
// ═══════════════════════════════════════════════════════════════

/**
 * [3093] ERROR — Operación sujeta a percepción sin cargo de percepción
 */
rule "3093_percepcion_sin_cargo"
    when
        $ctx : CpeContext( operacionSujetaPercepcion == true,
                           formaPagoContado == true,
                           sinCargoPercepcion == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3093", "Si operacion es sujeta a percepcion y la forma de pago es Contado, debe ingresar cargo para Percepcion");
end

/**
 * [3233] ERROR — Cargo percepción sin monto base
 */
rule "3233_cargo_percepcion_sin_monto_base"
    when
        $ctx : CpeContext( cargoPercepcionSinMontoBase == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3233", "Para cargo Percepcion, debe ingresar monto base y debe ser mayor a 0.00");
end

/**
 * [3262] ERROR — Retención IGV sin receptor agente de retención
 */
rule "3262_retencion_igv_receptor_no_agente"
    when
        $ctx : CpeContext( tieneRetencionIgv == true,
                           receptorNoEsAgenteRetencion == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3262", "Si existe retencion de IGV en el comprobante, el receptor debe ser un Agente de Retencion");
end

/**
 * [3263] ERROR — Importe retención incorrecto
 */
rule "3263_importe_retencion_incorrecto"
    when
        $ctx : CpeContext( importeRetencionIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3263", "El Importe de la retencion no tiene el valor correcto");
end

/**
 * [3264] ERROR — Base imponible retención mayor al importe total
 */
rule "3264_base_retencion_mayor_total"
    when
        $ctx : CpeContext( baseRetencionMayorTotal == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3264", "El importe total de la operacion (base imponible de retencion) no puede ser mayor al importe total del comprobante.");
end

/**
 * [3269] ERROR — Retención IGV con emisor agente de retención
 */
rule "3269_retencion_igv_emisor_es_agente"
    when
        $ctx : CpeContext( tieneRetencionIgv == true,
                           emisorEsAgenteRetencion == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3269", "Si existe retencion de IGV en el comprobante, el emisor no debe ser un Agente de Retencion");
end

/**
 * [3308] ERROR — Percepciones sin tipo operación 2001
 */
rule "3308_percepcion_sin_tipo_operacion_2001"
    when
        $ctx : CpeContext( tienePercepcion == true,
                           tipoOperacion != "2001" )
        $res : ResultadoValidacion()
    then
        $res.addError("3308", "Solo debe consignar informacion de percepciones si el tipo de operacion es 2001-Operacion sujeta a Percepcion");
end

/**
 * [3309] ERROR — Percepción sin Payment Terms contado
 */
rule "3309_percepcion_sin_payment_terms_contado"
    when
        $ctx : CpeContext( tipoOperacion == "2001",
                           formaPagoContado == true,
                           sinPaymentTermsPercepcion == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3309", "Si forma de pago es Contado debe consignar un Payment Terms con indicador Percepcion");
end

/**
 * [3310] ERROR — Falta monto total incluido percepción
 */
rule "3310_falta_monto_total_percepcion"
    when
        $ctx : CpeContext( tipoOperacion == "2001",
                           faltaMontoTotalPercepcion == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3310", "Debe consignar el Monto total incluido la percepcion");
end

/**
 * [3311] ERROR — Monto total percepción con formato inválido
 */
rule "3311_monto_total_percepcion_invalido"
    when
        $ctx : CpeContext( montoTotalPercepcionInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3311", "El Monto total incluido la percepcion no cumple con el formato establecido");
end

/**
 * [3316] ERROR — Retención 2da categoría sin tipo operación 2002
 */
rule "3316_retencion_2da_sin_tipo_2002"
    when
        $ctx : CpeContext( tipoOperacion == "2002",
                           faltaDatosRetencion2daCategoria == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3316", "Si el tipo de operacion es 2002, debe informar los datos de la retencion de segunda categoria");
end

/**
 * [3317] ERROR — Retención 2da categoría sin tipo operación 2002
 */
rule "3317_retencion_2da_sin_operacion_2002"
    when
        $ctx : CpeContext( tieneRetencion2daCategoria == true,
                           tipoOperacion != "2002" )
        $res : ResultadoValidacion()
    then
        $res.addError("3317", "Si consigna infomacion de la retencion de segunda categoria, el tipo de operacion debe ser 2002");
end

/**
 * [3318] ERROR — Falta base de retención 2da categoría
 */
rule "3318_falta_base_retencion_2da"
    when
        $ctx : CpeContext( faltaBaseRetencion2da == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3318", "Debe consignar la base de la retencion de segunda categoria");
end

/**
 * [3330] ERROR — Percepciones sin forma de pago contado
 */
rule "3330_percepcion_sin_contado"
    when
        $ctx : CpeContext( tienePercepcion == true,
                           formaPagoContado == false )
        $res : ResultadoValidacion()
    then
        $res.addError("3330", "Solo debe consignar informacion de percepciones si la forma de pago es 'Contado'");
end

