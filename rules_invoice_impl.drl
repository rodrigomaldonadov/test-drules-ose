// SECCIÓN 27 — TRIBUTOS GLOBALES Y DE LÍNEA
// ═══════════════════════════════════════════════════════════════

/**
 * [2638] ERROR — Tributo en línea sin total de tributo global ok
 */
rule "2638_tributo_linea_sin_total_global"
    when
        $ctx : CpeContext( tributoLineaSinTotalGlobal == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2638", "Si tiene operaciones de un tributo en alguna linea, debe consignar el tag del total del tributo");
end

/**
 * [2640] ERROR — Operación gratuita con más de un monto referencial
 */
rule "2640_operacion_gratuita_monto_referencial_multiple"
    when
        $ctx : CpeContext( operacionGratuitaMasDeUnMonto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2640", "Operacion gratuita, solo debe consignar un monto referencial");
end

/**
 * [2641] ERROR — Operación gratuita sin total valor venta gratuitas
 */
rule "2641_operacion_gratuita_sin_total_venta"
    when
        $ctx : CpeContext( esOperacionGratuita == true,
                           totalValorVentaGratuitas <= 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2641", "Operacion gratuita, debe consignar Total valor venta - operaciones gratuitas mayor a cero");
end

/**
 * [2642] ERROR — Exportación sin tipo afectación 40
 */
rule "2642_exportacion_sin_afectacion_40"
    when
        $ctx : CpeContext( tieneLineasExportacion == true,
                           exportacionConAfectacionIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2642", "Operaciones de exportacion, deben consignar Tipo Afectacion igual a 40");
end

/**
 * [2644] ERROR — IVAP con ítems de afectación distinta a 17
 */
rule "2644_ivap_con_afectacion_distinta_17"
    when
        $ctx : CpeContext( tipoOperacion == "1003",
                           ivapConAfectacionIncorrecta == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2644", "Comprobante operacion sujeta IVAP solo debe tener items con codigo de afectacion del IGV igual a 17");
end

/**
 * [2650] ERROR — IVAP con ISC mayor a cero
 */
rule "2650_ivap_con_isc"
    when
        $ctx : CpeContext( tipoOperacion == "1003",
                           totalIsc > 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2650", "Factura de operacion sujeta al IVAP , no debe consignar valor para ISC o debe ser 0");
end

/**
 * [2788] ERROR — Moneda de percepción debe ser PEN
 */
rule "2788_moneda_percepcion_no_pen"
    when
        $ctx : CpeContext( monedaPercepcionNoPen == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2788", "El dato ingresado en moneda debe ser PEN");
end

/**
 * [2792] ERROR — Moneda del cargo percepción debe ser PEN
 */
rule "2792_moneda_cargo_percepcion_no_pen"
    when
        $ctx : CpeContext( monedaCargoPercepcionNoPen == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2792", "El dato ingresado en moneda del monto de cargo/descuento para percepcion debe ser PEN");
end

/**
 * [2797] ERROR — Monto percepción mayor al importe total
 */
rule "2797_monto_percepcion_mayor_total"
    when
        $ctx : CpeContext( montoPercepcion > total,
                           montoPercepcion > 0 )
        $res : ResultadoValidacion()
    then
        $res.addError("2797", "El Monto de percepcion no puede ser mayor al importe total del comprobante.");
end

/**
 * [2798] ERROR — Monto percepción incorrecto según tipo
 */
rule "2798_monto_percepcion_incorrecto"
    when
        $ctx : CpeContext( montoPercepcionIncorrecto == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2798", "El Monto de percepcion no tiene el valor correcto segun el tipo de percepcion.");
end

/**
 * [2949] ERROR — Impuesto ICBPER no vigente
 */
rule "2949_icbper_no_vigente"
    when
        $ctx : CpeContext( icbperNoVigente == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2949", "El impuesto ICBPER no se encuentra vigente");
end

/**
 * [2954] ERROR — Código motivo cargo/descuento por línea inválido
 */
rule "2954_codigo_motivo_cargo_desc_linea_invalido"
    when
        $ctx : CpeContext( codigoMotivoCargDescLineaInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("2954", "El valor ingresado como codigo de motivo de cargo/descuento por linea no es valido (catalogo 53)");
end

