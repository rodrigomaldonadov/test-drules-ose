/**
 * [2999] ERROR — Total valor venta globales con formato inválido
 */
rule "2999_total_valor_venta_globales_invalido"
    when
        $ctx : CpeContext(
	    totalValorVentaGlobalesFormatoInvalido == true 
	    || !DecimalUtils.formatoValido(total, 12, 2))

        $res : ResultadoValidacion()
    then
        $res.addError("2999", "El dato ingresado en el total valor de venta globales no cumple con el formato establecido");
end

/**
 * [3000] ERROR — Impuesto sobre operaciones gratuitas/inafectas/exoneradas debe ser 0
 */
rule "3000_impuesto_gratuitas_debe_ser_cero"
    when
        $ctx : CpeContext( impuestoOperacionesGratuitasDistintoCero == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3000", "El monto total del impuestos sobre el valor de venta de operaciones gratuitas/inafectas/exoneradas debe ser igual a 0.00");
end

/**
 * [3003] ERROR — El XML no contiene el tag o no existe informacion de total valor de venta globales
 */
rule "3003_falta_total_valor_venta_globales"
    when
        $ctx : CpeContext( faltaTotalValorVentaGlobales == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3003", "El XML no contiene el tag o no existe informacion de total valor de venta globales");
end

/**
 * [3019] ERROR — Total precio de venta con formato inválido
 */
rule "3019_total_precio_venta_formato_invalido"
    when
       	$ctx : CpeContext(!DecimalUtils.formatoValido(total, 12, 2)  )
        $res : ResultadoValidacion()
    then
        $res.addError("3019", "El dato ingresado en total precio de venta no cumple con el formato establecido");
end

/**
 * [3020] ERROR — Monto total de impuestos formato inválido
 */
rule "3020_monto_total_impuestos_formato_invalido"
    when
        $ctx : CpeContext(!DecimalUtils.formatoValido(taxamuntGlobal, 12, 2) )
        $res : ResultadoValidacion()
    then
        $res.addError("3020", "El dato ingresado en el monto total de impuestos no cumple con el formato establecido");
end

/**
 * [3021] ERROR — Monto total de impuestos por línea con formato inválido
 */
rule "3021_monto_total_impuestos_linea_invalido"
    when
        $ctx : CpeContext( montoTotalImpuestosLineaInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3021", "El dato ingresado en el monto total de impuestos por linea no cumple con el formato establecido");
end

/**
 * [3024] ERROR — El tag cac:TaxTotal no debe repetirse a nivel de totales
 */
rule "3024_tax_total_repetido_totales"
    when
        $ctx : CpeContext( taxTotalRepetidoTotales == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3024", "El tag cac:TaxTotal no debe repetirse a nivel de totales");
end

/**
 * [3026] ERROR — TaxTotal repetido a nivel de item
 */
rule "3026_tax_total_repetido_item"
    when
        $ctx : CpeContext( taxTotalRepetidoItem == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3026", "El tag cac:TaxTotal no debe repetirse a nivel de Item");
end

/**
 * [3031] ERROR — TaxableAmount de línea con formato inválido
 */
rule "3031_taxable_amount_linea_invalido"
    when
        $ctx : CpeContext( taxableAmountLineaInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3031", "El dato ingresado en TaxableAmount de la linea no cumple con el formato establecido");
end

/**
 * [3067] ERROR — Código de tributo repetido a nivel de item
 */
rule "3067_codigo_tributo_repetido_item"
    when
        $ctx : CpeContext( codigoTributoRepetidoItem == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3067", "El codigo de tributo no debe repetirse a nivel de item");
end

/**
 * [3068] ERROR — Código de tributo repetido a nivel de totales
 */
rule "3068_codigo_tributo_repetido_totales"
    when
        $ctx : CpeContext( codigoTributoRepetidoTotales == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3068", "El codigo de tributo no debe repetirse a nivel de totales");
end

/**
 * [3102] ERROR — Factor de afectación por línea con formato inválido
 */
rule "3102_factor_afectacion_linea_invalido"
    when
        $ctx : CpeContext( factorAfectacionLineaInvalido == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3102", "El dato ingresado como factor de afectacion por linea no cumple con el formato establecido.");
end

/**
 * [3103] ERROR — Factor x base IGV/IVAP no corresponde al monto
 */
rule "3103_factor_base_igv_no_corresponde"
    when
        $ctx : CpeContext( factorBaseIgvNoCorresponde == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3103", "El producto del factor y monto base de la afectacion del IGV/IVAP no corresponde al monto de afectacion de linea.");
end

/**
 * [3104] ERROR — Factor ISC por línea igual a 0.00
 */
rule "3104_factor_isc_linea_cero"
    when
        $ctx : CpeContext( factorIscLineaCero == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3104", "El factor de afectacion de ISC por linea debe ser diferente a 0.00.");
end

/**
 * [3105] ERROR — Línea sin al menos un tributo IGV
 */
rule "3105_linea_sin_tributo_igv"
    when
        $ctx : CpeContext( lineaSinTributoIgv == true )
        $res : ResultadoValidacion()
    then
        $res.addError("3105", "El XML debe contener al menos un tributo por linea de afectacion por IGV");
end

/**
 * [3108] ERROR — Factor x base ISC no corresponde
 */
rule "3108_factor_base_isc_no_corresponde"
    when
        $ctx : CpeContext( factorBaseIscNoCorresponde == true )
